+def _codes_to_words(c):
+    """c int64 [..., 8] codes in (pairsel, rowhalf, h) order -> int32 words (bit positions _POS)."""
+    c = c.reshape(-1, 8)
+    q = torch.zeros(c.shape[0], dtype=torch.int64, device=c.device)
