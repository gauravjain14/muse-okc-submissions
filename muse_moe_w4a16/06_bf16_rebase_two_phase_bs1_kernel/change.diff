+  } else if constexpr (sh == 26) {
+    return (lo >> 26) * c_m6h[0] + 0x5C005C00u;
+  } else if constexpr (sh <= 26) {
+    return ((lo >> sh) & 63u) * c_m6h[0] + 0x5C005C00u;
+  } else {
