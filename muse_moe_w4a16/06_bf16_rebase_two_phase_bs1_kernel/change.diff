+template <int H> DEVI void dequant_hs(u32 q, u32 sg, u32 sg8, u32& a0, u32& a1, u32& a2, u32& a3) {
+#ifdef MOE_NO_DEQ
+  a0 = q; a1 = q ^ sg; a2 = q + sg8; a3 = q; return;  // (timing only)
+#endif
