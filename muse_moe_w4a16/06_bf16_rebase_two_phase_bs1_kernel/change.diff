+  return a ^ b;
+#else
+  u32 d;
+  if constexpr (H == 0) asm("{ .reg .b16 l, h; .reg .b32 t; mov.b32 {l, h}, %2; mov.b32 t, {l, l}; mul.rn.f16x2 %0, %1, t; }" : "=r"(d) : "r"(a), "r"(b));
