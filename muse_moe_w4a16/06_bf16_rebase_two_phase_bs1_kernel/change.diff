+// selector (HMUL2.BF16 R, R, R.H0_H0 / .H1_H1): one PRMT and one IMAD per two scale pairs
+template <int J> DEVI u32 scale2_b(u32 w) {
+  u32 x;
+  asm("prmt.b32 %0, %1, 0, %2;" : "=r"(x) : "r"(w), "n"(0x4040 | ((J + 2) << 8) | J));
+  return x * c_s16 + 0x77007700u;
