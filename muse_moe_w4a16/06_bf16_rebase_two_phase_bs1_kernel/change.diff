+// scale pairs instead of per pair
+template <int J> DEVI u32 scale2_h(u32 w) {
+  u32 x;
+  asm("prmt.b32 %0, %1, 0, %2;" : "=r"(x) : "r"(w), "n"(0x4040 | ((J + 2) << 8) | J));
+  return x * c_h128 + 0x3C003C00u;
