+  u32 sg0, sg80, sg1, sg81;
+  if constexpr (S6V) {
+    sg0 = scale6<2 * kk>(s6w0, s6w1, s6w2); sg80 = scale6<2 * kk + 1>(s6w0, s6w1, s6w2);
+    sg1 = scale6<8 + 2 * kk>(s6w0, s6w1, s6w2); sg81 = scale6<9 + 2 * kk>(s6w0, s6w1, s6w2);
