+@_dlgl.jit
+def _boundary2_vector(P, S: _dgl.constexpr, T, NU: _dgl.constexpr, S1, A2, B2, GPOST, GNEXT, SOUT, HOUT,
+               V: _dgl.constexpr, NW: _dgl.constexpr, USE_PDL: _dgl.constexpr = False):
+    t = _dgl.program_id(0)
+    offs = _dgl.arange(0, 8192, layout=_dgl.BlockedLayout([V], [32], [NW], [0]))
+    m = offs < NU
+    gp = 1.0 + _dgl.load(GPOST + offs).to(_dgl.float32)      # weights, and S1 from _boundary1: every kernel between them (pooler/router, route,
