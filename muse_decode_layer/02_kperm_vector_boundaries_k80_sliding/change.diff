+# Changes: ported to Triton Gluon with an explicit vectorized BlockedLayout (V elements per thread); reads precomputed residual-gate coefficients alpha / beta instead of `_gate_ab`; also stores the FP32 normalized activation for the router at T <= 8.
+# License text: LICENSES/Apache-2.0.txt; notices: NOTICE (repository root).
+@_dlgl.jit
+def _boundary1_vector(P, S: _dgl.constexpr, T, STREAM, A1, B1, G, S1OUT, HOUT, ROUTER_OUT, KEEP_ROUTER: _dgl.constexpr, V: _dgl.constexpr, NW: _dgl.constexpr, USE_PDL: _dgl.constexpr = False):
+    t = _dgl.program_id(0)
+    offs = _dgl.arange(0, 8192, layout=_dgl.BlockedLayout([V], [32], [NW], [0]))
+    a1v, b1v = _dgl.load(A1 + offs), _dgl.load(B1 + offs)              # weights and the layer's input stream: no producer dependency
+    stv = _dgl.load(STREAM + t * 8192 + offs)
+    gw = 1.0 + _dgl.load(G + offs).to(_dgl.float32)
