+    s, c = p >> 4, p & 15
+    lg, j, t, i = s >> 2, s & 3, (c >> 1) & 3, (c & 1) | ((c >> 3) << 1)
+    k = 16 * (4 * t + j) + 4 * lg + i
+    assert sorted(k.tolist()) == list(range(256))
+    return k
