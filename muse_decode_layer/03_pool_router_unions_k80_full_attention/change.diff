+def _dl_build_xg5():
+    global _XG5_MOD, _XG5_NSM
+    _XG5_NSM = torch.cuda.get_device_properties(0).multi_processor_count
+    if _XG5_MOD is None:
+        _XG5_MOD = _XG5Mod()
