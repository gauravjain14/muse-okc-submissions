+// ---------------------------------------------------------------------------------------------
+// qkv_post2's per-warp arithmetic for one pass: 4 head vectors (8 lanes each, 8 elements per lane)
+DEVI void post_vec(const SlaP& p, uint4 raw, int hv, float (&cs)[4], float (&sn)[4], u32& lo, u32& hi, float cq, float ik, float iv) {
+  const __nv_bfloat162* h2 = reinterpret_cast<const __nv_bfloat162*>(&raw);
+  float x[8];
+#pragma unroll
+  for (int k = 0; k < 4; ++k) { x[2 * k] = __low2float(h2[k]); x[2 * k + 1] = __high2float(h2[k]); }
+  // the 8-lane sum runs on every lane (V lanes too: no divergent shuffles); only Q and K use it
+  float ss = 0.f;
+#pragma unroll
+  for (int k = 0; k < 8; ++k) ss += x[k] * x[k];
+  ss += __shfl_xor_sync(0xffffffff, ss, 1);
+  ss += __shfl_xor_sync(0xffffffff, ss, 2);
+  ss += __shfl_xor_sync(0xffffffff, ss, 4);
+  if (hv < 18) {
+    const float r = rsqrtf(ss * (1.f / 64.f) + 1e-5f);
+#pragma unroll
+    for (int k = 0; k < 8; ++k) x[k] *= r;
+    if (p.rope) {
+#pragma unroll
+      for (int k = 0; k < 4; ++k) {
+        const float y0 = x[2 * k] * cs[k] - x[2 * k + 1] * sn[k], y1 = x[2 * k] * sn[k] + x[2 * k + 1] * cs[k];
+        x[2 * k] = y0; x[2 * k + 1] = y1;
+      }
+    }
+  }
+  const float sc = hv < 16 ? cq : (hv < 18 ? ik : iv);
+  lo = (u32)f2_to_e4m3x2(x[0] * sc, x[1] * sc) | ((u32)f2_to_e4m3x2(x[2] * sc, x[3] * sc) << 16);
+  hi = (u32)f2_to_e4m3x2(x[4] * sc, x[5] * sc) | ((u32)f2_to_e4m3x2(x[6] * sc, x[7] * sc) << 16);
+}
+DEVI void rope_cs(const SlaP& p, int pos, int sub, float (&cs)[4], float (&sn)[4]) {
+  if (pos < p.npos) {
+    const float4* tb = reinterpret_cast<const float4*>(p.rope_tab + ((size_t)pos * 32 + 4 * sub) * 2);
+    const float4 a = tb[0], c = tb[1];
+    cs[0] = a.x; sn[0] = a.y; cs[1] = a.z; sn[1] = a.w; cs[2] = c.x; sn[2] = c.y; cs[3] = c.z; sn[3] = c.w;
+  } else {
+#pragma unroll
+    for (int k = 0; k < 4; ++k) sincosf((float)pos * p.inv_freq[4 * sub + k], &sn[k], &cs[k]);
+  }
+}
