+  if (tid == 0) {
+    for (int s = 0; s < SLA_NS; ++s) {
+      mbar_init(bars + 16 * s, 1);
+      mbar_init(bars + 16 * s + 8, CW);
+    }
+    mbar_init(gbar, 1);
+    mbar_init(xbar, 1);
+    mbar_init(sbar, 2);
+    asm volatile("fence.mbarrier_init.release.cluster;" ::: "memory");
+  }
+  for (int i = tid; i < SLA_NS * 256; i += blockDim.x)
+    reinterpret_cast<u32*>(smem + (i >> 8) * 18432 + 16384)[i & 255] = 0x38383838u;
+  asm volatile("fence.proxy.async.shared::cta;" ::: "memory");
+  __syncthreads();
+  if (tid == 128) mbar_arrive_tx(xbar, 384 * 68);   // the partner's 384 threads x 68 bytes
+  asm volatile("barrier.cluster.arrive;" ::: "memory");
+  if (!p.fused) asm volatile("griddepcontrol.wait;" ::: "memory");   // PDL: qkv_post2's q8 / new keys
+  // the unit's tiles and this rank's share
+  const int L0 = p.seq_lens[b];
+  const int i0 = qb * QB, i1 = min(i0 + QB, p.L);
+  const int lo = p.window ? max(0, L0 + i0 - (p.window - 1)) : 0, hi = L0 + i1;
+  const int bt = base_tile(p, L0);
+  const int nt = (hi + 127) / 128 - lo / 128;
+#if SLA_SPLIT == 0
+  const int mid = max(1, (nt - 1) / 2);
+#elif SLA_SPLIT == 1
+  const int mid = max(1, nt / 2);
+#else
+  const int mid = max(1, (nt + 1) / 2);
+#endif
