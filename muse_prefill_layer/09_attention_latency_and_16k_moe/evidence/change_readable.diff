+    asm volatile("setmaxnreg.dec.sync.aligned.u32 %0;" :: "n"(SLA_PREG) : "memory");
+#if SLA_PUB
+    if (p.fused && (tid >> 5) == 1) {
+      // publisher: once every consumer has stored its new keys, make them visible and count this CTA in
+      asm volatile("bar.sync 2, 416;" ::: "memory");
+      if (tid == 32) {
+#if SLA_PUB == 2
+        asm volatile("fence.proxy.async.global;" ::: "memory");
