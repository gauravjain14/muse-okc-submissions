+#define SLA_NS 8
+#endif
+#define CW 3
+#define QB 24
+#ifndef SLA_CREG
+#define SLA_CREG 160
+#endif
+#ifndef SLA_PREG
+#define SLA_PREG 32
+#endif
+#ifndef SLA_PREP
+#define SLA_PREP 0           // 1: exponent codes before the PV wait; 2: also P packed before it (double-buffered P)
+#endif
+#ifndef SLA_PUB
+#define SLA_PUB 1            // 0: fence + release on the Q path; 1: writers fence, warp 1 releases; 2: warp 1 fences too
+#endif
+#ifndef SLA_GPRE
+#define SLA_GPRE 1           // producer-warpgroup warps 2-3 turn the prefetched gates into FP32 sigmoids during the main loop
+#endif
+#ifndef SLA_FMASK
+#define SLA_FMASK 1          // masked tiles: f16 key-offset compare (sign of min(k - lo, hi - k)) instead of integer selects
+#endif
+#ifndef SLA_CACHE_C
+#define SLA_CACHE_C 1        // the EXPQ bias 1080 - 8 m kept in registers, recomputed only on a rescale (same bits)
+#endif
+#ifndef SLA_PP
+#define SLA_PP 0             // 1: consumer warpgroups issue their wgmmas round robin
+#endif
+#ifndef SLA_SPLIT
+#define SLA_SPLIT 0          // 0: s1's split (rank 0 gets max(1, (nt - 1) / 2) tiles); 1: rank 0 gets nt / 2; 2: (nt + 1) / 2
