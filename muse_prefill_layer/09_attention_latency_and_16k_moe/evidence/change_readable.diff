+struct SlaP {
+  const __nv_bfloat16* qkv;    // [T][2304]
+  const u8* q8;                // non-fused: [T][16][64] FP8 from qkv_post2
+  u8* k_cache;
+  u8* v_cache;
+  const long long* cache_loc;
+  const int* page_table;
+  const int* seq_lens;
+  const float* k_scale;
+  const float* v_scale;
+  const float* inv_freq;
+  const float* rope_tab;
+  u8* kp;
+  u8* vp;
+  __nv_bfloat16* out;          // [T][1024]
+  int* sync;                   // [0] pack done, [1] exit count, [2 + 2 b + h] new keys published (per request, head)
+  u64* trace;
+  int B, L, window, rope, page, max_pages, nta, nqb, npos, nblk_pack, flagjoin, fused;
+  float qscale;
+};
+
+DEVI int base_tile(const SlaP& p, int L0) { return p.window ? max(0, L0 - (p.window - 1)) / 128 : 0; }
+
+// ---------------------------------------------------------------------------------------------
+// sla_pack: kv_pack part 3 (cached keys' tiles; the cached bytes of the tile where new keys start) + a done count.
+// Blocks [0, B*2*nta) pack one (request, head, tile); the last B blocks reset the request's ready counters.
+DEVI u32 prmt(u32 a, u32 b, u32 sel) { u32 r; asm("prmt.b32 %0, %1, %2, %3;" : "=r"(r) : "r"(a), "r"(b), "r"(sel)); return r; }
+extern "C" __global__ void __launch_bounds__(256) sla_pack(SlaP p) {
+  __shared__ u32 vsw[128 * 17];
+  const int nblk = p.B * 2 * p.nta;
+  const int tid = threadIdx.x;
+  bool work = (int)blockIdx.x < nblk;
+  if (!work) {
+    const int b = blockIdx.x - nblk;
+    if (tid < 2) p.sync[2 + 2 * b + tid] = 0;
+  }
+  int tile = 0, h = 0, b = 0, L0 = 0, total = 0, lo_req = 0, k0 = 0;
+  if (work) {
+    tile = blockIdx.x % p.nta; h = (blockIdx.x / p.nta) & 1; b = blockIdx.x / (2 * p.nta);
+    L0 = p.seq_lens[b];
+    total = L0 + p.L;
+    lo_req = p.window ? max(0, L0 - (p.window - 1)) : 0;
+    k0 = (base_tile(p, L0) + tile) * 128;
+    if (k0 >= total) work = false;
+    if (k0 >= L0 && k0 + 128 <= total) work = false;   // all new keys: the attention CTAs pack them
+  }
+  if (work) {
+    u8* kd = p.kp + ((size_t)(b * 2 + h) * p.nta + tile) * 8192;
+    u8* vd = p.vp + ((size_t)(b * 2 + h) * p.nta + tile) * 8192;
+    const bool mixed = k0 + 128 > L0;
+    int pg[2];
+    bool ok[2];
+#pragma unroll
+    for (int r = 0; r < 2; ++r) {
+      const int pos = k0 + ((tid + 256 * r) >> 2);
+      ok[r] = pos < total && pos >= lo_req;
+      pg[r] = ok[r] ? __ldg(p.page_table + b * p.max_pages + pos / p.page) : 0;
+    }
+    uint4 kv[2], vv[2];
+#pragma unroll
+    for (int r = 0; r < 2; ++r) {
+      const int u = tid + 256 * r, kk = u >> 2, c = u & 3, pos = k0 + kk;
+      kv[r] = vv[r] = make_uint4(0, 0, 0, 0);
+      if (ok[r]) {
+        const long long rowi = (long long)pg[r] * p.page + pos % p.page;
+        kv[r] = __ldg(reinterpret_cast<const uint4*>(p.k_cache + rowi * 128 + h * 64 + c * 16));
+        vv[r] = __ldg(reinterpret_cast<const uint4*>(p.v_cache + rowi * 128 + h * 64 + c * 16));
+      }
+    }
+#pragma unroll
+    for (int r = 0; r < 2; ++r) {
+      const int u = tid + 256 * r, kk = u >> 2, c = u & 3, pos = k0 + kk;
+      if (!(mixed && pos >= L0 && pos < total)) *reinterpret_cast<uint4*>(kd + kk * 64 + ((c ^ ((kk >> 1) & 3)) << 4)) = kv[r];
+      u32* vrow = vsw + kk * 17 + c * 4;
+      vrow[0] = vv[r].x; vrow[1] = vv[r].y; vrow[2] = vv[r].z; vrow[3] = vv[r].w;
+    }
+    __syncthreads();
+    if (tid < 128) {
+      const int w = tid & 15, un = tid >> 4;
+      u32 x[16];
+#pragma unroll
+      for (int e = 0; e < 16; ++e) x[e] = vsw[(16 * un + e) * 17 + w];
+      u32 o[4][4];
+#pragma unroll
+      for (int q = 0; q < 4; ++q) {
+        const u32 t0 = prmt(x[2 * q], x[2 * q + 1], 0x5140), t1 = prmt(x[2 * q], x[2 * q + 1], 0x7362);
+        const u32 t2 = prmt(x[2 * q + 8], x[2 * q + 9], 0x5140), t3 = prmt(x[2 * q + 8], x[2 * q + 9], 0x7362);
+        o[0][q] = prmt(t0, t2, 0x5410); o[1][q] = prmt(t0, t2, 0x7632);
+        o[2][q] = prmt(t1, t3, 0x5410); o[3][q] = prmt(t1, t3, 0x7632);
+      }
+#pragma unroll
+      for (int j = 0; j < 4; ++j) {
+        const int d = 4 * w + j;
+        u8* dst = vd + d * 128 + ((un ^ (d & 7)) << 4);
+        if (!mixed) {
+          *reinterpret_cast<uint4*>(dst) = make_uint4(o[j][0], o[j][1], o[j][2], o[j][3]);
+        } else {
+#pragma unroll
+          for (int e = 0; e < 16; ++e) {
+            const int pos = k0 + 16 * un + 2 * (e >> 2) + (e & 1) + 8 * ((e >> 1) & 1);
+            if (!(pos >= L0 && pos < total)) dst[e] = (u8)(o[j][e >> 2] >> (8 * (e & 3)));
+          }
+        }
+      }
+    }
+  }
+  if (p.flagjoin) {
+    asm volatile("fence.proxy.async.global;" ::: "memory");
+    __syncthreads();
+    if (tid == 0) { __threadfence(); red_release_add(p.sync, 1); }
+  }
+}
