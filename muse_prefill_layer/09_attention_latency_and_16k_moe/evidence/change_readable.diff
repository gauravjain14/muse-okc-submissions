+    // the gates of the tokens this rank finishes (12 even or odd tokens): after the first ring fill
+    auto gates = [&]() {
+      if (!gdc) { asm volatile("griddepcontrol.wait;" ::: "memory"); gdc = true; }
+      int nv = 0;
+      for (int k = 0; k < 12; ++k) nv += (i0 + 2 * k + rank < p.L);
+      mbar_arrive_tx(gbar, nv * 1024);
+      for (int k = 0; k < 12; ++k) {
+        const int ti = i0 + 2 * k + rank;
+        if (ti < p.L) bulk_g2s(sbase + OFF_G + k * 1024, p.qkv + (size_t)(b * p.L + ti) * 2304 + 1280 + h * 512, 1024, gbar);
+      }
+    };
+    if (n <= 0) gates();
+    for (int j = 0; j < n; ++j) {
+      const int st = j % SLA_NS;
+      const bool isnew = (bt + tfirst + j) * 128 + 128 > L0;
+      if (!gdc && (isnew || j >= SLA_NS)) {
+        asm volatile("griddepcontrol.wait;" ::: "memory");
+        gdc = true;
+      }
+      if (isnew && !rdy) {
+        while (ld_acquire(p.sync + 2 + 2 * b + h) < need) { }
+        asm volatile("fence.proxy.async.global;" ::: "memory");
+        rdy = true;
+      }
+      if (j >= SLA_NS) mbar_wait(bars + 16 * st + 8, ((j / SLA_NS) & 1) ^ 1);
+      const u32 full = bars + 16 * st;
+      mbar_arrive_tx(full, 16384);
+      bulk_g2s(sbase + st * 18432, p.kp + (tix0 + j) * 8192, 8192, full);
+      bulk_g2s(sbase + st * 18432 + 8192, p.vp + (tix0 + j) * 8192, 8192, full);
+      if (j == min(n, SLA_NS) - 1) gates();
+    }
+    return;
+  }
+
+  asm volatile("setmaxnreg.inc.sync.aligned.u32 %0;" :: "n"(SLA_CREG) : "memory");
+  const float vsc_epi = p.v_scale[0];
+  const int c = wg - 1, warp = lt >> 5, lane = lt & 31;
+  const int g = lane >> 2, tq = lane & 3;
+  const int tok_a = c * 8 + 2 * warp, tok_b = tok_a + 1;
+  const int head = g;
+  const int ia = i0 + tok_a, ib = i0 + tok_b;
+  const bool va = ia < p.L, vb = ib < p.L;
+  const int pa = L0 + ia, pb = L0 + ib;
+  const int hg = h * 8 + head;
+  u32 qa[2][4];
+  if (p.fused) {
