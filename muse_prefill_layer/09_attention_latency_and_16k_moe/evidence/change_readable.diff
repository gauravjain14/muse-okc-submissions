+// ---------------------------------------------------------------------------------------------
+// shared memory layout
+#define OFF_Q (SLA_NS * 18432)
+#define OFF_G (OFF_Q + 12288)
+#define OFF_GF (OFF_G + 12288)
+#define OFF_X (OFF_GF + 24576)
+#define OFF_XL (OFF_X + 384 * 64)
+#define OFF_BAR (OFF_XL + 384 * 4)
+#define SLA_SMEM (OFF_BAR + 16 * SLA_NS + 64)   // barriers: full/empty [NS], gate, exchange, sigmoid
+
+extern "C" __global__ void __cluster_dims__(2, 1, 1) __launch_bounds__(128 * (1 + CW), 1) sla_fwd(SlaP p) {
+  STR(0);
+  extern __shared__ __align__(1024) u8 smem[];
+  const u32 sbase = smem_addr(smem);
+  const u32 bars = sbase + OFF_BAR;
+  const u32 gbar = bars + 16 * SLA_NS, xbar = gbar + 8, sbar = gbar + 16;
+  const int tid = threadIdx.x, wg = tid >> 7, lt = tid & 127;
+  const int rank = blockIdx.x & 1, u = blockIdx.x >> 1;
