+SLA_FUSED = 1
+SLA_FLAGJOIN = 1
+SLA_DEFINES = ['SLA_SPLIT 0', 'SLA_TRIG', 'SLA_CACHE_C 2', 'SLA_PP 1', 'SLA_GPRE 0']
+SLA_MAX_GRID = 128
+SLA_TRACE = False
+
+
+class _SlaP(ctypes.Structure):
+    _fields_ = [(n, ctypes.c_void_p) for n in ('qkv', 'q8', 'k_cache', 'v_cache', 'cache_loc', 'page_table', 'seq_lens',
+                                               'k_scale', 'v_scale', 'inv_freq', 'rope_tab', 'kp', 'vp', 'out', 'sync',
+                                               'trace')] + \
+        [(n, ctypes.c_int) for n in ('B', 'L', 'window', 'rope', 'page', 'max_pages', 'nta', 'nqb', 'npos', 'nblk_pack',
+                                     'flagjoin', 'fused')] + [('qscale', ctypes.c_float)]
+
+
+def _sla_smem(ns):
+    # must match sla.cu: stages | Q 12 KB | gates BF16 12 KB | sigmoid gates FP32 24 KB | exchange 24 KB + 1.5 KB | barriers
+    return ns * 18432 + 12288 + 12288 + 24576 + 384 * 64 + 384 * 4 + 16 * ns + 64
+
+
+class _Sla:
+    def __init__(self, att, device):
+        self.mod = _AttCuda(SLA_SRC, list(SLA_DEFINES))
+        self.ns = 8
+        for d in SLA_DEFINES:
+            if d.startswith('SLA_NS '):
+                self.ns = int(d.split()[1])
+        self.smem = _sla_smem(self.ns)
+        self.sync = torch.zeros(2 + 2 * 64, dtype=torch.int32, device=device)
+        self.trace = torch.zeros(132 * 64, dtype=torch.int64, device=device)
+        # The new-key ready counter and the sla_pack done count are spin-waited: every cluster must be co-resident and
+        # a few SMs must stay free for the side-stream pack. Otherwise the shape takes the base attention path.
+        self.nsm = torch.cuda.get_device_properties(device).multi_processor_count
+        self.max_clusters = self._max_clusters()
+        print(f'sla: {self.nsm} SMs, {self.max_clusters} co-resident 2-CTA clusters of sla_fwd', flush=True)
+
+    def _max_clusters(self):
+        try:
+            d = self.mod.driver
+            f = self.mod.func('sla_fwd', self.smem)
+            cfg = d.CUlaunchConfig()
+            cfg.gridDimX, cfg.gridDimY, cfg.gridDimZ = (128, 1, 1)
+            cfg.blockDimX, cfg.blockDimY, cfg.blockDimZ = (512, 1, 1)
+            cfg.sharedMemBytes = self.smem
+            at = d.CUlaunchAttribute()
+            at.id = d.CUlaunchAttributeID.CU_LAUNCH_ATTRIBUTE_CLUSTER_DIMENSION
+            at.value.clusterDim.x, at.value.clusterDim.y, at.value.clusterDim.z = (2, 1, 1)
+            cfg.attrs = [at]
+            cfg.numAttrs = 1
+            err, n = d.cuOccupancyMaxActiveClusters(f, cfg)
+            if int(err):
+                cfg.attrs = []
+                cfg.numAttrs = 0
+                err, n = d.cuOccupancyMaxActiveClusters(f, cfg)
+            return int(n) if not int(err) else 0
+        except Exception as e:
+            print('sla: cluster occupancy query failed:', e, flush=True)
+            return 0
+
+    def ok(self, cfg):
+        if not cfg['window'] or cfg['rope_theta'] not in (0.0, 500000.0):
+            return False
+        B, L = cfg['batch'], cfg['q_len']
+        nqb = (L + 23) // 24
+        clusters = 2 * B * nqb
+        return 4 * B * nqb <= SLA_MAX_GRID and B <= 64 and clusters <= self.max_clusters and 2 * clusters <= self.nsm - 4
+
+    def params(self, att, data, qkv, bf):
+        cfg = data['config']
+        B, L = cfg['batch'], cfg['q_len']
+        pt = data['page_table']
+        p = _SlaP()
+        p.qkv = qkv.data_ptr() if qkv is not None else 0
+        p.q8 = bf['q8'].data_ptr()
+        p.k_cache, p.v_cache = data['k_cache'].data_ptr(), data['v_cache'].data_ptr()
+        p.cache_loc, p.page_table, p.seq_lens = data['cache_loc'].data_ptr(), pt.data_ptr(), data['seq_lens'].data_ptr()
+        p.k_scale, p.v_scale = data['k_scale'].data_ptr(), data['v_scale'].data_ptr()
+        p.inv_freq, p.rope_tab = att.inv_freq.data_ptr(), att.rope_tab.data_ptr()
+        p.kp, p.vp, p.out = bf['kp'].data_ptr(), bf['vp'].data_ptr(), bf['out'].data_ptr()
+        p.sync, p.trace = self.sync.data_ptr(), self.trace.data_ptr()
+        p.B, p.L, p.window, p.rope = B, L, cfg['window'], 1 if cfg['rope_theta'] else 0
+        p.page, p.max_pages, p.nta, p.nqb = cfg['page_size'], pt.shape[1], bf['nta'], (L + 23) // 24
+        p.npos = att.npos
+        p.nblk_pack = B * 2 * bf['nta'] + B
+        p.flagjoin, p.fused = SLA_FLAGJOIN, SLA_FUSED
+        p.qscale = float(cfg['sm_scale'] * cfg['qk_scale_factor'] * ATT_LOG2E)
+        return p
+
+
+_sla_pa_fork = PrefillAttention.fork
+_sla_pa_pre = PrefillAttention.pre
+_sla_pa_call = PrefillAttention.__call__
+
+
+def _sla_use(self, data):
+    sla = getattr(self, 'sla', None)
+    return sla is not None and sla.ok(data['config'])
+
+
+def _sla_fork(self, data=None):
+    self.sla_mode = data is not None and _sla_use(self, data)
+    return _sla_pa_fork(self, data)
+
+
+def _sla_pre(self, data):
+    if not getattr(self, 'sla_mode', False):
+        return _sla_pa_pre(self, data)
+    if getattr(self, 'fork_ev', None) is None:
+        _sla_pa_fork(self, data)
+    self.side.wait_event(self.fork_ev)
+    self.fork_ev = None
+    cfg = data['config']
+    bf = self._bufs(cfg, data['page_table'].shape[1], cfg['page_size'], data['k_cache'].device)
+    p = self.sla.params(self, data, None, bf)
+    with torch.cuda.stream(self.side):
+        self.sla.mod.launch('sla_pack', p.nblk_pack, 256, 0, p)
+    self.sla_pre_done = True
+
+
+def _sla_call(self, data, qkv):
+    if not (getattr(self, 'sla_mode', False) and getattr(self, 'sla_pre_done', False)):
+        return _sla_pa_call(self, data, qkv)
+    self.sla_pre_done = False
+    self.sla_mode = False
+    cfg = data['config']
+    bf = self._bufs(cfg, data['page_table'].shape[1], cfg['page_size'], data['k_cache'].device)
+    p = self.sla.params(self, data, qkv, bf)
+    if not SLA_FUSED:
+        prm, _ = self._params(data, qkv)
+        prm.direct_new = 1
+        self.mod.launch('qkv_post2', (prm.B * prm.L + 7) // 8, 256, 0, prm, pdl=True)
+    if SLA_FLAGJOIN:
+        self.sla_join = True
+    else:
+        torch.cuda.current_stream().wait_stream(self.side)
+    self.sla.mod.launch('sla_fwd', 4 * p.B * p.nqb, 512, self.sla.smem, p, pdl=True)
+    return bf['out']
+
+
+def _sla_join(att):
+    if att is not None and getattr(att, 'sla_join', False):
+        torch.cuda.current_stream().wait_stream(att.side)
+        att.sla_join = False
+
+
+PrefillAttention.fork = _sla_fork
+PrefillAttention.pre = _sla_pre
+PrefillAttention.__call__ = _sla_call
+_sla_prev_kernel_fn = kernel_fn
+
+
+def kernel_fn(data, state):
+    r = _sla_prev_kernel_fn(data, state)
+    _sla_join(state.get('att'))
+    return r
+
+
+def _front(data, state):
+    """front-of-layer probe hook (research/claude/attn/front.py): s1's front + the deferred join."""
+    cfg = data['config']
+    dense = state['dense']
+    state['att'].fork(data)
+    smt = None if cfg['window'] else state.get('qkv_smt', {}).get(data['attn_input'].shape[0])
+    qkv = smt[0].run(data['attn_input'], dense['qkv_gate'], smt[1]) if smt is not None else _gemm(data['attn_input'], dense['qkv_gate'])
+    state['att'].pre(data)
+    o = state['att'](data, qkv)
+    if cfg['tokens'] in state.get('d6_plans', {}):
+        _sla_join(state['att'])
+        return o
+    r = _gemm(o, dense['o'])
+    _sla_join(state['att'])
+    return r
+
+
+_sla_prev_prepare = prepare
+
+
+def prepare(weights):
+    state = _sla_prev_prepare(weights)
+    att = state.get('att')
+    if att is not None:
+        att.sla = _Sla(att, weights['qkv_gate'].device)
+    torch.cuda.synchronize()
+    return state
