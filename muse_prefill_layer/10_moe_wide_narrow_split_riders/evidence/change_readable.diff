+// ---- rw: kernel W's one consumer. RIDE_: host 256 + rider (consumer_combo's loop, rw's pinned offsets / constant
+// rider multipliers); else a plain wide item (worker W's ww_wide_loop). Then one runtime-width host epilogue. ----
+template <int CB, bool EP_REMAT, bool MAT_SMALL, int FINE>
+DEVI void rw_consumer_w(const Args& p, uint8_t* ring, uint8_t* stg, uint32_t bars, int& slot, uint32_t& ph,
+                        int e, int row0, int ntile, bool GATED, int N, int* done, unsigned long long* t_mid,
+                        volatile long long* pubq, int nreal, bool RIDE_, int re, int rrow0, int rntile, int* rdone,
+                        int rnreal, int rn) {
