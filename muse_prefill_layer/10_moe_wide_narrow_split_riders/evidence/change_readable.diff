+# ==== stk (research/claude/stk): shared hooks for lever A (L2 prefetch of the next cuBLASLt GEMM's first weight
+# k-stages) and lever B (small-kernel trims around the MoE). Every flag off = m16's code paths. ====
+import os as _stk_os
+import triton.language.extra.cuda as _stk_tlc  # noqa: F401  (gdc_wait for the PDL combine)
+STK_PF_UNPOOL = 0       # A: k-stages of the unpool GEMM's weights the combine kernel prefetches into L2 (0 = off)
+STK_COMB_HOIST = False  # B: combine with every route's loads issued up front (same arithmetic, same order)
+STK_COMB_PDL = False    # B: combine launched with PDL (constants and the prefetch before griddepcontrol.wait)
+STK_MAX_T = 8191        # both levers only below the 16K path (T >= 8192 keeps m16's kernels)
+_STK_GATHER = [None]    # B: replacement gather + plan launcher
+_STK_ZBAR = [None]      # B: the fused router + gather's barrier words, zeroed by the combine (program 0)
+
+
+@triton.jit
+def _stk_combine_kernel(y_ptr, rrow_ptr, lid_ptr, w_ptr, gs_ptr, pw_ptr, out_ptr, reset_ptr, pg_slot_ptr, pg_count_ptr,
+                        zero_scratch_ptr, pf_base, pf_lines, pf_per_row, pf_ld, zbar_ptr, H: tl.constexpr, PGK: tl.constexpr = 0, ZBAR: tl.constexpr = 0,
+                        ZERO_SIZE: tl.constexpr = 0, ZERO_BLOCK: tl.constexpr = 0, CACHE_HINT: tl.constexpr = False,
+                        PF: tl.constexpr = 0, HOIST: tl.constexpr = False, GDC: tl.constexpr = False):
+    t = tl.program_id(0)
+    if PF > 0:
+        # lever A: this program's share of the unpool GEMM's first weight k-stages (128-byte lines) into L2
+        j = tl.minimum(t * PF + tl.arange(0, PF), pf_lines - 1)
+        addr = pf_base + (j // pf_per_row).to(tl.int64) * pf_ld + (j % pf_per_row).to(tl.int64) * 128
+        tl.inline_asm_elementwise("prefetch.global.L2 [$1];\n\tmov.u32 $0, 0;", "=r,l", [addr], dtype=tl.int32,
+                                  is_pure=False, pack=1)
+    offs = tl.arange(0, H)
+    pw = 1.0 + tl.load(pw_ptr + offs).to(tl.float32)
+    if GDC:
+        tl.extra.cuda.gdc_wait()
+    if tl.program_id(0) == 0:
+        tl.store(reset_ptr + tl.arange(0, 32), 0)
+        if PGK:
+            tl.store(pg_slot_ptr + tl.arange(0, 32 * PGK), -1)
+            tl.store(pg_count_ptr, 0)
+        if ZERO_SIZE:
+            zi = tl.arange(0, ZERO_BLOCK)
+            tl.store(zero_scratch_ptr + zi, 0, mask=zi < ZERO_SIZE)
+        if ZBAR:
+            tl.store(zbar_ptr + tl.arange(0, ZBAR), 0)
+    acc = tl.zeros([H], dtype=tl.float32)
+    if HOIST:
+        # every route's lid / row / weight, then every local route's row: all loads in flight at once; the
+        # arithmetic below is the original loop body, route by route in the same order
+        b8 = t * 8
+        l0 = tl.load(lid_ptr + b8 + 0, eviction_policy=("evict_last" if CACHE_HINT else ""))
+        l1 = tl.load(lid_ptr + b8 + 1, eviction_policy=("evict_last" if CACHE_HINT else ""))
+        l2 = tl.load(lid_ptr + b8 + 2, eviction_policy=("evict_last" if CACHE_HINT else ""))
+        l3 = tl.load(lid_ptr + b8 + 3, eviction_policy=("evict_last" if CACHE_HINT else ""))
+        l4 = tl.load(lid_ptr + b8 + 4, eviction_policy=("evict_last" if CACHE_HINT else ""))
+        l5 = tl.load(lid_ptr + b8 + 5, eviction_policy=("evict_last" if CACHE_HINT else ""))
+        l6 = tl.load(lid_ptr + b8 + 6, eviction_policy=("evict_last" if CACHE_HINT else ""))
+        l7 = tl.load(lid_ptr + b8 + 7, eviction_policy=("evict_last" if CACHE_HINT else ""))
+        r0 = tl.load(rrow_ptr + b8 + 0, eviction_policy=("evict_last" if CACHE_HINT else ""))
+        r1 = tl.load(rrow_ptr + b8 + 1, eviction_policy=("evict_last" if CACHE_HINT else ""))
+        r2 = tl.load(rrow_ptr + b8 + 2, eviction_policy=("evict_last" if CACHE_HINT else ""))
+        r3 = tl.load(rrow_ptr + b8 + 3, eviction_policy=("evict_last" if CACHE_HINT else ""))
+        r4 = tl.load(rrow_ptr + b8 + 4, eviction_policy=("evict_last" if CACHE_HINT else ""))
+        r5 = tl.load(rrow_ptr + b8 + 5, eviction_policy=("evict_last" if CACHE_HINT else ""))
+        r6 = tl.load(rrow_ptr + b8 + 6, eviction_policy=("evict_last" if CACHE_HINT else ""))
+        r7 = tl.load(rrow_ptr + b8 + 7, eviction_policy=("evict_last" if CACHE_HINT else ""))
+        w0 = tl.load(w_ptr + b8 + 0, eviction_policy=("evict_last" if CACHE_HINT else ""))
+        w1 = tl.load(w_ptr + b8 + 1, eviction_policy=("evict_last" if CACHE_HINT else ""))
+        w2 = tl.load(w_ptr + b8 + 2, eviction_policy=("evict_last" if CACHE_HINT else ""))
+        w3 = tl.load(w_ptr + b8 + 3, eviction_policy=("evict_last" if CACHE_HINT else ""))
+        w4 = tl.load(w_ptr + b8 + 4, eviction_policy=("evict_last" if CACHE_HINT else ""))
+        w5 = tl.load(w_ptr + b8 + 5, eviction_policy=("evict_last" if CACHE_HINT else ""))
+        w6 = tl.load(w_ptr + b8 + 6, eviction_policy=("evict_last" if CACHE_HINT else ""))
+        w7 = tl.load(w_ptr + b8 + 7, eviction_policy=("evict_last" if CACHE_HINT else ""))
+        v0 = (l0 >= 0) & (l0 < 32)
+        v1 = (l1 >= 0) & (l1 < 32)
+        v2 = (l2 >= 0) & (l2 < 32)
+        v3 = (l3 >= 0) & (l3 < 32)
+        v4 = (l4 >= 0) & (l4 < 32)
+        v5 = (l5 >= 0) & (l5 < 32)
+        v6 = (l6 >= 0) & (l6 < 32)
+        v7 = (l7 >= 0) & (l7 < 32)
+        y0 = tl.load(y_ptr + tl.where(v0, r0, 0).to(tl.int64) * H + offs, mask=(offs < H) & v0, other=0.0, eviction_policy=("evict_first" if CACHE_HINT else ""))
+        y1 = tl.load(y_ptr + tl.where(v1, r1, 0).to(tl.int64) * H + offs, mask=(offs < H) & v1, other=0.0, eviction_policy=("evict_first" if CACHE_HINT else ""))
+        y2 = tl.load(y_ptr + tl.where(v2, r2, 0).to(tl.int64) * H + offs, mask=(offs < H) & v2, other=0.0, eviction_policy=("evict_first" if CACHE_HINT else ""))
+        y3 = tl.load(y_ptr + tl.where(v3, r3, 0).to(tl.int64) * H + offs, mask=(offs < H) & v3, other=0.0, eviction_policy=("evict_first" if CACHE_HINT else ""))
+        y4 = tl.load(y_ptr + tl.where(v4, r4, 0).to(tl.int64) * H + offs, mask=(offs < H) & v4, other=0.0, eviction_policy=("evict_first" if CACHE_HINT else ""))
+        y5 = tl.load(y_ptr + tl.where(v5, r5, 0).to(tl.int64) * H + offs, mask=(offs < H) & v5, other=0.0, eviction_policy=("evict_first" if CACHE_HINT else ""))
+        y6 = tl.load(y_ptr + tl.where(v6, r6, 0).to(tl.int64) * H + offs, mask=(offs < H) & v6, other=0.0, eviction_policy=("evict_first" if CACHE_HINT else ""))
+        y7 = tl.load(y_ptr + tl.where(v7, r7, 0).to(tl.int64) * H + offs, mask=(offs < H) & v7, other=0.0, eviction_policy=("evict_first" if CACHE_HINT else ""))
+        if v0:
+            y = y0.to(tl.float32) * pw
+            rr = tl.rsqrt(tl.sum(y * y, 0) / H + 1e-08)
+            acc += y * (rr * w0)
+        if v1:
+            y = y1.to(tl.float32) * pw
+            rr = tl.rsqrt(tl.sum(y * y, 0) / H + 1e-08)
+            acc += y * (rr * w1)
+        if v2:
+            y = y2.to(tl.float32) * pw
+            rr = tl.rsqrt(tl.sum(y * y, 0) / H + 1e-08)
+            acc += y * (rr * w2)
+        if v3:
+            y = y3.to(tl.float32) * pw
+            rr = tl.rsqrt(tl.sum(y * y, 0) / H + 1e-08)
+            acc += y * (rr * w3)
+        if v4:
+            y = y4.to(tl.float32) * pw
+            rr = tl.rsqrt(tl.sum(y * y, 0) / H + 1e-08)
+            acc += y * (rr * w4)
+        if v5:
+            y = y5.to(tl.float32) * pw
+            rr = tl.rsqrt(tl.sum(y * y, 0) / H + 1e-08)
+            acc += y * (rr * w5)
+        if v6:
+            y = y6.to(tl.float32) * pw
+            rr = tl.rsqrt(tl.sum(y * y, 0) / H + 1e-08)
+            acc += y * (rr * w6)
+        if v7:
+            y = y7.to(tl.float32) * pw
+            rr = tl.rsqrt(tl.sum(y * y, 0) / H + 1e-08)
+            acc += y * (rr * w7)
+    else:
+        for k in tl.static_range(8):
+            lid = tl.load(lid_ptr + t * 8 + k, eviction_policy=("evict_last" if CACHE_HINT else ""))
+            if (lid >= 0) & (lid < 32):
+                row = tl.load(rrow_ptr + t * 8 + k, eviction_policy=("evict_last" if CACHE_HINT else ""))
+                y = tl.load(y_ptr + row.to(tl.int64) * H + offs, eviction_policy=("evict_first" if CACHE_HINT else "")).to(tl.float32) * pw
+                rr = tl.rsqrt(tl.sum(y * y, 0) / H + 1e-08)
+                acc += y * (rr * tl.load(w_ptr + t * 8 + k, eviction_policy=("evict_last" if CACHE_HINT else "")))
+    tl.store(out_ptr + t.to(tl.int64) * H + offs, acc.to(tl.bfloat16))
+
+
+def _stk_pf_unpool(state, M):
+    """(base, lines, per_row, ld) of the unpool GEMM's first STK_PF_UNPOOL k-stages (64 K-columns each), or None."""
+    if not STK_PF_UNPOOL or M > STK_MAX_T:
+        return None
+    cache = state.setdefault('stk_pfu', {})
+    if M not in cache:
+        w = state['dense']['unpooler']                    # [8192, 4096] BF16
+        sel = _PREFILL_LT_PLANS.get((M, w.shape[0], w.shape[1], w.data_ptr()))
+        wt = getattr(sel[0], 'wt', None) if sel is not None else None
+        S = STK_PF_UNPOOL
+        if wt is not None:   # 'nn': W^T [4096, 8192], the first S*64 rows are contiguous
+            cache[M] = (wt.data_ptr(), S * 64 * wt.shape[1] * 2 // 128, 1 << 30, 0)
+        else:                # 'tn' (or cuBLAS default): W [8192, 4096] K-major, S 128-byte lines at the head of every row
+            cache[M] = (w.data_ptr(), w.shape[0] * S, S, w.shape[1] * 2)
+    return cache[M]
+
+
+def _stk_combine(ex, lid, topk_weights, ps, nx, out, M, pg_xs, state, counts):
+    pf = _stk_pf_unpool(state, M)
+    pfa = pf if pf is not None else (0, 1, 1, 0)
+    PFN = 0
+    if pf is not None:
+        PFN = 1
+        while PFN * M < pf[1]:
+            PFN *= 2
+    kw = dict(H=4096, PGK=PG_KMAX if pg_xs is not None else 0, num_warps=8, ZERO_SIZE=ps['moe_zero_scratch'].numel(),
+              ZERO_BLOCK=triton.next_power_of_2(ps['moe_zero_scratch'].numel()), CACHE_HINT=2048 <= M < 8192, PF=PFN,
+              HOIST=bool(STK_COMB_HOIST and M <= STK_MAX_T), GDC=bool(STK_COMB_PDL and M <= STK_MAX_T))
+    if kw['GDC']:
+        kw['launch_pdl'] = True
+    zb = _STK_ZBAR[0]
+    if zb is not None:
+        kw['ZBAR'] = zb.numel()
+    _stk_combine_kernel[M,](ex['y'], ex['rrow'], lid, topk_weights, ps['ones32'], ps['g_post_expert_norm'], out, counts, nx['tslot'], nx['nslot'], ps['moe_zero_scratch'], pfa[0], pfa[1], pfa[2], pfa[3], zb if zb is not None else counts, **kw)
+
+
+def _stk_moe_forward(st, p, lid, pos, cnt, T, order=None, zb=None, cit=None, pg_xs=None, pg_slots=None):
+    """_pm__moe_forward with an optional gather replacement (lever B); otherwise the same launches."""
+    g = _STK_GATHER[0]
+    if g is None or pg_xs is not None or cit is not None or T > STK_MAX_T or not _pm_GATHER_PLAN or _pm_MOE_MODE_SMALL != 'fused' or T >= _pm_MOE_LARGE_T:
+        return _pm__moe_forward(st, p, lid, pos, cnt, T, order=order, zb=zb, cit=cit, pg_xs=pg_xs, pg_slots=pg_slots)
+    dev = p.device
+    mod = st['mod']
+    maxrows = T * _pm_TOP_K + _pm_LOCAL_EXPERTS * _pm_MAX_PADDED_ROWS_PER_EXPERT
+    maxtiles = _pm__max_tiles(T)
+    offsets = torch.empty((_pm_LOCAL_EXPERTS,), dtype=torch.int32, device=dev)
+    rows = torch.empty((_pm_LOCAL_EXPERTS,), dtype=torch.int32, device=dev)
+    tiles = torch.empty((maxtiles, 4), dtype=torch.int32, device=dev)
+    ntiles = torch.empty((1,), dtype=torch.int32, device=dev)
+    if order is None:
+        order = _pm_MOE_ORDER_SMALL
+    fine = 1 if _pm_FINE_MIN_T and T >= _pm_FINE_MIN_T else 0
+    order = order | fine << _pm_MOE_FINE_ORDER_SHIFT
+    xt = torch.empty((maxrows, _pm_D_EXPERT), dtype=torch.bfloat16, device=dev)
+    rrow = torch.empty((T, _pm_TOP_K), dtype=torch.int32, device=dev)
+    cz, ctok = st['no_zero'], st['no_zero']
+    g(st, p, lid, pos, cnt, xt, rrow, offsets, tiles, ntiles, rows, order, T)
+    inter = torch.empty((maxrows, _pm_D_EXPERT), dtype=torch.bfloat16, device=dev)
+    y = torch.empty((maxrows, _pm_D_EXPERT), dtype=torch.bfloat16, device=dev)
+    if zb is None:
+        zb = torch.zeros((1 + maxtiles,), dtype=torch.int32, device=dev)
+    mod.moe_fused(st['w13r'], st['w2r'], xt, inter, y, tiles, ntiles, st['w13_gs'], st['w2_gs'], st['nsm'] * (2 if _pm_SKINNY_TEST else 1), st['smem'], zb[0:1], zb[1:1 + maxtiles], st['moe_dbg'], st['moe_flags'] | fine << _pm_MOE_FINE_ORDER_SHIFT, cz, ctok, rrow, lid, st['no_zero_f'], st['g_post_expert_norm'], st['no_zero_b'])
+    return dict(y=y, rrow=rrow, xt=xt, inter=inter, tiles=tiles, ntiles=ntiles, offsets=offsets, rows=rows, counters=zb)
+
