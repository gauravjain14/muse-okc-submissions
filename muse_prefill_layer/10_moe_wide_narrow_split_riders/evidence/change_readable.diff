+
+def _experts(x, topk_weights, topk_ids, state, prenorm=False, bucketed=False, pg_xs=None):
+    M = x.shape[0]
+    on = (STK_PF_UNPOOL or STK_COMB_HOIST or STK_COMB_PDL or _STK_GATHER[0] is not None) and M <= STK_MAX_T
+    if not on or M < 512 or M > MAX_M:
+        return _stk_prev_experts(x, topk_weights, topk_ids, state, prenorm, bucketed, pg_xs)
+    ps = state['public_experts']
+    nx = state['native_experts']
+    if prenorm:
+        x = F.rms_norm(x, (4096,), ps['prenorm'], 1e-05).to(x.dtype)
+    if bucketed:
+        lid, pos, counts = (topk_ids, nx['spos'].view(-1)[:M * 8].view(M, 8), nx['cur'])
+    else:
+        lid = torch.empty((M, 8), device=x.device, dtype=torch.int32)
+        pos = torch.empty_like(lid)
+        counts = torch.zeros(32, device=x.device, dtype=torch.int32)
+        _pm__mopt_public_bucket[triton.cdiv(M * 8, 256),](topk_ids, lid, pos, counts, M * 8, 0, 256)
+    ex = _stk_moe_forward(ps, x, lid, pos, counts, M, pg_xs=pg_xs, pg_slots=nx['tslot'] if pg_xs is not None else None, zb=ps['moe_zero_scratch'])
+    out = torch.empty_like(x)
+    _stk_combine(ex, lid, topk_weights, ps, nx, out, M, pg_xs, state, counts)
+    return out
