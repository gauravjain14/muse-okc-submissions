+#endif
+        if constexpr (MAT_SMALL || EP_REMAT) convert8_reuse(q, scale_pair_sel(sw, j & 1, m16), afrag[j & 1], m16, m64); else convert8(q, scale_pair_sel(sw, j & 1, m16), afrag[j & 1], m16, m64);
