+  } else {
+    const int woff = ((wg * 4 + w) * 32 + lane) * 16, soff = 4096 + ((wg * 4 + w) * 8 + g) * 8;
+    const int zw_ = (int)(p.mul16 ^ 16u);
+    if (FINE == 0 || N == 256) ww_wide_loop<256, CR>(acc, ring, bars, slot, ph, woff, soff, lane, t_mid, zw_);
+    else if (N == 224) ww_wide_loop<224, CR>(acc, ring, bars, slot, ph, woff, soff, lane, t_mid, zw_);
+    else if (N == 208) ww_wide_loop<208, CR>(acc, ring, bars, slot, ph, woff, soff, lane, t_mid, zw_);
+    else if (N == 192) ww_wide_loop<192, CR>(acc, ring, bars, slot, ph, woff, soff, lane, t_mid, zw_);
+    else ww_wide_loop<160, CR>(acc, ring, bars, slot, ph, woff, soff, lane, t_mid, zw_);
