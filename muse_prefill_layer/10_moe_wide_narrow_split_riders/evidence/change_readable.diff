+# ==== stk: MoE gather + plan infrastructure (shared by levers A and B) ====
+# stk_gather<TPC>: moe_gather_kernel<true>'s exact work (plan / offsets / rrow / tile-layout rows / pad zero fill), TPC
+# tokens per CTA, pad-fill CTAs first; block 0 (plan) can also L2-prefetch the expert kernel's first-wave weight stages
+# (lever A, a.npf items). The dispatcher picks per T: the fused router + gather (lever B), stk_gather, or m16's gather.
+STK_GATHER_TPC = int(_stk_os.environ.get('STK_GATHER_TPC', '0'))        # tokens per CTA below 2048 tokens (0: m16's gather)
+STK_GATHER_TPC_L = int(_stk_os.environ.get('STK_GATHER_TPC_L', '0'))    # tokens per CTA from 2048 tokens (0: m16's gather)
+STK_GATHER_PARTS = int(_stk_os.environ.get('STK_GATHER_PARTS', '8'))
+STK_GTRACE = int(_stk_os.environ.get('STK_GTRACE', '0'))
+STK_GPADFIRST = int(_stk_os.environ.get('STK_GPADFIRST', '1'))   # pad-fill CTAs before the token CTAs
+STK_MOEPF = 0           # A: first-wave expert items whose first weight stage the plan CTA prefetches (0 = off)
+
+
+def _stk_moe_helpers():
+    """The MoE plan's helpers (rem_tile / rem_tiles / plan_warp + MOE_FINE_MASK), verbatim from the expert module."""
+    src = _pm__CUDA_SRC
+    i0 = src.index('DEVI int rem_tile(int r, int fine) {')
+    i1 = src.index('__global__ void moe_plan_kernel(')
+    body = src[i0:i1]
+    m = [ln for ln in src.split('\n') if ln.startswith('#define MOE_FINE_MASK ')]
+    assert len(m) == 1 and 'plan_warp' in body and 'rem_tiles' in body
+    return m[0] + '\n' + body.replace('rem_tile', 'stk_rem_tile').replace('plan_warp', 'stk_plan_warp')
+
+
+STK_GATHER_SRC = '\n// ---- stk: MoE gather + plan with TPC tokens per CTA, pad-fill CTAs first ----\n' + _stk_moe_helpers() + r'''
+struct StkGP {
+  const unsigned short* p; const int* lid; const int* pos; const int* counts;
+  unsigned char* xt; int* rrow; int* offsets; int4* tiles; int* ntiles; int* rows;
+  int T, order, npad, parts;
+  unsigned long long* dbg;   // STK_GTRACE builds: per-CTA globaltimer stamps
+  const unsigned char* w13; int npf, matsmall;   // A: the expert kernel's first-wave weight stages to prefetch
+};
+// A: the expert kernel's first npf GEMM1 items (its claim order: item i -> (tile, weight n-tile) as moe_fused_persistent's
+// producer maps it), first weight stage (kps x 4608 bytes) of each into L2. Lane l of the plan warp, after the plan.
+DEVI void stk_moe_pf(const StkGP& a, int lane) {
+  if (a.w13 == nullptr || a.npf <= 0) return;
+  __syncwarp();
+  const int nt = __ldcg(a.ntiles);
+  const int n1 = nt * 64;
+  for (int item = lane; item < n1 && item < a.npf; item += 32) {
+    int tile, ntile;
+    if (a.matsmall) {
+      if (item < nt * 32) { tile = (item / 8) % nt; ntile = (item / (nt * 8)) * 8 + item % 8; }
+      else { const int rest = item - nt * 32; tile = rest / 32; ntile = 32 + rest % 32; }
+    } else { tile = item / 64; ntile = item % 64; }
+    const int4 ti = __ldcg(a.tiles + tile);
+    const int n = ti.z, kps = n >= 160 ? 1 : (n <= 32 ? 4 : 2);
+    asm volatile("cp.async.bulk.prefetch.L2.global [%0], %1;" :: "l"(a.w13 + (size_t)(ti.x * 64 + ntile) * 64 * 4608), "r"(kps * 4608) : "memory");
+  }
+}
+DEVI unsigned long long stk_gt() { unsigned long long t; asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t)); return t; }
+#ifdef STK_GTRACE
+#define GTR(i) do { if (threadIdx.x == 0 && a.dbg) a.dbg[blockIdx.x * 4 + (i)] = stk_gt(); } while (0)
+#else
+#define GTR(i) do {} while (0)
+#endif
+// token CTAs first (TPC tokens each), then npad pad-fill CTAs. Every global load the CTA needs (counts, its routes'
+// lid / pos, its rows) is issued right after the PDL wait; the expert offsets come from one warp scan (moe_gather's),
+// counts[l] / offsets[l] from shared memory: one dependent round trip before the stores (moe_gather: three).
+template <int TPC>
+DEVI void stk_gather_body(const StkGP& a) {
+  GTR(0);
+  asm volatile("griddepcontrol.launch_dependents;" ::: "memory");
+  asm volatile("griddepcontrol.wait;" ::: "memory");
+  GTR(1);
+  const int tid = threadIdx.x;
+  const int fine = a.order >> 8;
+  const int ntc = (a.T + TPC - 1) / TPC;
+  const bool tokc = (int)blockIdx.x < ntc;
+  __shared__ int off_s[32], cnt_s[32];
+  __shared__ long long mrow[8 * TPC];
+  __shared__ int mn[8 * TPC], mlr[8 * TPC];
+  const int tok0 = (int)blockIdx.x * TPC;
