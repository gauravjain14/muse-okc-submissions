+// (the incumbent's N >= 160 loop: one k-block a stage, one commit group per k16, wait<1>); same per-element arithmetic
+// and order as consumer_item<N> (bit-identical outputs).
+#ifndef WW_XPF_MAX
+#define WW_XPF_MAX 0     // widths <= this load the next stage's weight codes one k-block ahead (cross-stage)
+#endif
+#ifndef WW_SLOT
+#define WW_SLOT SLOT     // kernel W's ring slot (wide stages only: 256 x 128 + 4608 <= 37888)
+#endif
+template <int NN, bool CONV_REUSE>
+DEVI void ww_wide_loop(float (&acc)[128], uint8_t* ring, uint32_t bars, int& slot, uint32_t& ph, int woff, int soff, int lane,
+                       unsigned long long* t_mid, int zx = 0) {
+  constexpr int XB = NN * 128;
+  constexpr int RS_ = WW_SLOT;
+  constexpr bool XPF_ = NN <= WW_XPF_MAX;
+  static_assert(XB + WBLK <= WW_SLOT, "wide stage does not fit kernel W's slot");
+  const uint32_t m16 = 16u, m64 = 64u;
+#if !WW_SCALE0
+#pragma unroll
+  for (int i = 0; i < NN / 2; ++i) acc[i] = 0.f;
+#endif
+  uint32_t afrag[2][4];
+  int prev = -1;
+  mbar_wait(bars + 8 * slot, ph);
+  if (t_mid) t_mid[1] = clock64();
+  uint4 nwq = *reinterpret_cast<const uint4*>(ring + slot * RS_ + XB + woff);
+  uint2 nsc = *reinterpret_cast<const uint2*>(ring + slot * RS_ + XB + soff);
+  for (int it = 0; it < KS; ++it) {
+    asm volatile("" : "+r"(woff), "+r"(soff));  // rw: pinned in registers
+    uint8_t* st = ring + slot * RS_;
+    const uint8_t* wbase = st + XB + woff;
+    const uint8_t* sbase = st + XB + soff;
+    const uint64_t dbase = desc_sw128(smem_u32(st));
+    if (!XPF_ && it > 0) {
+      mbar_wait(bars + 8 * slot, ph);
+      nwq = *reinterpret_cast<const uint4*>(wbase);
+      nsc = *reinterpret_cast<const uint2*>(sbase);
+    }
+    const uint4 wq = nwq;
+    const uint2 sc = nsc;
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+      const uint32_t q = j == 0 ? wq.x : j == 1 ? wq.y : j == 2 ? wq.z : wq.w;
+      const uint32_t sw = j < 2 ? sc.x : sc.y;
+      if constexpr (CONV_REUSE) convert8_reuse(q, scale_pair_sel(sw, j & 1, m16), afrag[j & 1], m16, m64); else convert8(q, scale_pair_sel(sw, j & 1, m16), afrag[j & 1], m16, m64);
+      wg_fence();
+      // WW_SCALE0: the item's first k16 step overwrites the accumulators (scale-d 0) instead of a zero-init (which
+      // ptxas staged through ~34 uniform registers, leaving none for the item's other uniform state)
+      wgmma_rs<NN>(acc, afrag[j & 1], dbase + 2 * j, WW_SCALE0 ? (j > 0 || it > 0) : 1);
+      wg_commit();
+      if (XPF_ && j == 2 && it + 1 < KS) {  // ww xpf: the next stage's codes while k16 steps 1, 2 run (X and codes share
+        const int ns = slot + 1 == NSLOT ? 0 : slot + 1;  // one full barrier)
+        mbar_wait(bars + 8 * ns, slot + 1 == NSLOT ? ph ^ 1 : ph);
+        nwq = *reinterpret_cast<const uint4*>(ring + ns * RS_ + XB + woff);
+        nsc = *reinterpret_cast<const uint2*>(ring + ns * RS_ + XB + soff);
+      }
+      wg_wait<1>();
+      if (j == 0 && prev >= 0) { rel_sync(); if (MOE_ALLLANE_RELEASE || lane == 0) mbar_arrive(bars + 8 * NSLOT + 8 * prev); }
+    }
+    prev = slot;
+    if (++slot == NSLOT) { slot = 0; ph ^= 1; }
+  }
+  wg_wait<0>();
+  rel_sync();
+  if (MOE_ALLLANE_RELEASE || lane == 0) mbar_arrive(bars + 8 * NSLOT + 8 * prev);
+}
+template <int CB, bool EP_REMAT, bool MAT_SMALL, int FINE>
+DEVI void consumer_item_wide(const Args& p, uint8_t* ring, uint8_t* stg, uint32_t bars, int& slot, uint32_t& ph,
+                             int e, int row0, int ntile, bool GATED, int N, int* done, unsigned long long* t_mid,
+                             volatile long long* pubq, int nreal) {
+  const int ctid = threadIdx.x - CB;
+  const int wg = ctid >> 7;
+  const int w = (ctid >> 5) & 3;
+  const int lane = ctid & 31;
+  const int g = lane >> 2;
+  float acc[128];
+  const int woff = ((wg * 4 + w) * 32 + lane) * 16, soff = 4096 + ((wg * 4 + w) * 8 + g) * 8;
+  constexpr bool CR = MAT_SMALL || EP_REMAT;
+  if (FINE == 0 || N == 256) ww_wide_loop<256, CR>(acc, ring, bars, slot, ph, woff, soff, lane, t_mid);
+  else if (N == 224) ww_wide_loop<224, CR>(acc, ring, bars, slot, ph, woff, soff, lane, t_mid);
+  else if (N == 208) ww_wide_loop<208, CR>(acc, ring, bars, slot, ph, woff, soff, lane, t_mid);
+  else if (N == 192) ww_wide_loop<192, CR>(acc, ring, bars, slot, ph, woff, soff, lane, t_mid);
+  else ww_wide_loop<160, CR>(acc, ring, bars, slot, ph, woff, soff, lane, t_mid);
+  if (t_mid) t_mid[0] = clock64();
+  // ---- epilogue through the dedicated staging buffer (runtime width: one copy of the code for every wide class) ----
+  const float cs = p.gscale[e] * 128.f;
+  if (ctid == 0) wait_staging_free(pubq);
+  named_bar_sync(1, 256);  // previous item's copy-out is done with the staging buffer
+  if (t_mid) t_mid[2] = clock64();
+  if (GATED) {
+    const int q = wg * 4 + w;
+    const int n32 = N >> 5;
+#pragma unroll
+    for (int j4 = 0; j4 < 8; ++j4) {
+      if (j4 < n32) {
+        uint32_t r[4];
+#pragma unroll
+        for (int u = 0; u < 4; ++u) {
+          const int jj = 4 * j4 + u;
+          const float h0 = silu_fast(acc[4 * jj] * cs) * (acc[4 * jj + 2] * cs);
+          const float h1 = silu_fast(acc[4 * jj + 1] * cs) * (acc[4 * jj + 3] * cs);
+          r[u] = bf162_u32(__floats2bfloat162_rn(h0, h1));
+        }
+        const int rr = lane & 7, tokr = 8 * (4 * j4 + (lane >> 3)) + rr;
+        const uint32_t addr = smem_u32(stg + tokr * 128 + ((q ^ rr) << 4));
+        asm volatile("stmatrix.sync.aligned.m8n8.x4.trans.shared.b16 [%0], {%1, %2, %3, %4};" ::"r"(addr), "r"(r[0]),
+                     "r"(r[1]), "r"(r[2]), "r"(r[3]) : "memory");
+      }
+    }
+    if (FINE != 0 && N == 208) {  // 208 = 6 x 32 + 16: the last 16 tokens (accumulator groups 24, 25)
+      uint32_t r[2];
+#pragma unroll
+      for (int u = 0; u < 2; ++u) {
+        const int jj = 24 + u;
+        const float h0 = silu_fast(acc[4 * jj] * cs) * (acc[4 * jj + 2] * cs);
+        const float h1 = silu_fast(acc[4 * jj + 1] * cs) * (acc[4 * jj + 3] * cs);
+        r[u] = bf162_u32(__floats2bfloat162_rn(h0, h1));
+      }
+      const int rr = lane & 7, tokr = 192 + (lane & 15);
+      const uint32_t addr = smem_u32(stg + tokr * 128 + ((q ^ rr) << 4));
+      asm volatile("stmatrix.sync.aligned.m8n8.x2.trans.shared.b16 [%0], {%1, %2};"
+                   :: "r"(addr), "r"(r[0]), "r"(r[1]) : "memory");
+    }
+    asm volatile("fence.proxy.async.shared::cta;" ::: "memory");
+    named_bar_sync(1, 256);
+    if (ctid == 0) enqueue_out(pubq, p.out + (size_t)row0 * 8192 + (size_t)ntile * N * 128, done, 0, N * 128);
+  } else {
+    // down: half 0 (tokens 0..127) staged and copied out by the consumers, half 1 (N - 128 tokens) to the publisher
+    uint32_t ep_tid;
+    asm volatile("mov.u32 %0, %%tid.x;" : "=r"(ep_tid) :: "memory");
+    const int ep_ctid = (int)ep_tid - CB;
+    const int ep_q = ep_ctid >> 5;
+    const int ep_lane = ep_ctid & 31;
+#pragma unroll
+    for (int j2 = 0; j2 < 8; ++j2) {
+      uint32_t r[4];
+#pragma unroll
+      for (int u = 0; u < 2; ++u) {
+        const int ai = 4 * (2 * j2 + u);
+        r[2 * u] = bf162_u32(__floats2bfloat162_rn(acc[ai] * cs, acc[ai + 1] * cs));
+        r[2 * u + 1] = bf162_u32(__floats2bfloat162_rn(acc[ai + 2] * cs, acc[ai + 3] * cs));
+      }
+      const int m = ep_lane >> 3, rr = ep_lane & 7;
+      const int tl = 8 * (2 * j2 + (m >> 1)) + rr;
+      const uint32_t addr = smem_u32(stg + tl * 272 + (ep_q * 16 + 8 * (m & 1)) * 2);
+      asm volatile("stmatrix.sync.aligned.m8n8.x4.trans.shared.b16 [%0], {%1, %2, %3, %4};" ::"r"(addr), "r"(r[0]),
+                   "r"(r[1]), "r"(r[2]), "r"(r[3]) : "memory");
+    }
+#if !WW_BIGSTG
+    named_bar_sync(1, 256);
+    for (int i = ctid; i < 128 * 16; i += 256) {
+      const int tl = i >> 4, c = i & 15;
+      *reinterpret_cast<uint4*>(p.out + ((size_t)(row0 + tl) * 4096 + ntile * 128) * 2 + c * 16) =
+          *reinterpret_cast<const uint4*>(stg + tl * 272 + c * 16);
+    }
+    named_bar_sync(1, 256);
+    constexpr int H1 = 0;  // half 1 reuses staging rows 0..
+#else
+    constexpr int H1 = 128;  // ww bigstg: half 1 in staging rows 128.. (the staging holds all 256 rows)
+#endif
+    const int nj2 = (N - 128) >> 4;  // half 1: 2, 4, 5, 6 or 8 groups of 16 tokens
+#pragma unroll
+    for (int j2 = 0; j2 < 8; ++j2) {
+      if (j2 < nj2) {
+        uint32_t r[4];
+#pragma unroll
+        for (int u = 0; u < 2; ++u) {
+          const int ai = 4 * (2 * j2 + u + 16);
+          r[2 * u] = bf162_u32(__floats2bfloat162_rn(acc[ai] * cs, acc[ai + 1] * cs));
+          r[2 * u + 1] = bf162_u32(__floats2bfloat162_rn(acc[ai + 2] * cs, acc[ai + 3] * cs));
+        }
+        const int m = ep_lane >> 3, rr = ep_lane & 7;
+        const int tl = H1 + 8 * (2 * j2 + (m >> 1)) + rr;
+        const uint32_t addr = smem_u32(stg + tl * 272 + (ep_q * 16 + 8 * (m & 1)) * 2);
+        asm volatile("stmatrix.sync.aligned.m8n8.x4.trans.shared.b16 [%0], {%1, %2, %3, %4};" ::"r"(addr), "r"(r[0]),
+                     "r"(r[1]), "r"(r[2]), "r"(r[3]) : "memory");
+      }
+    }
+    named_bar_sync(1, 256);
+    if (ctid == 0) {
+      if (H1) enqueue_out(pubq, p.out + ((size_t)row0 * 4096 + ntile * 128) * 2, done, 1, N, row0, nreal);
+      else enqueue_out(pubq, p.out + ((size_t)(row0 + 128) * 4096 + ntile * 128) * 2, done, 1, N - 128, row0, nreal);
+    }
+  }
+}
