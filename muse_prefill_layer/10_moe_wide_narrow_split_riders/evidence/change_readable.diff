+      }
+    }
+    item_epilogue<RN, CB, EP_REMAT, MAT_SMALL, false>(p, racc, stg, GATED ? 32768 : 34816, re, rrow0, rntile, GATED,
+                                                      rdone, pubq, rnreal, nullptr, rn);
