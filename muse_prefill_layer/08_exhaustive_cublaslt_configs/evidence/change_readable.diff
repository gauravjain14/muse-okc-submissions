+        lib.cublasLtMatmulAlgoCheck.restype = i_
+        self.library, self.m, self.n, self.k, self.out32 = (library, m, n, k, out32)
+        self.desc, self.a, self.b, self.c = [_ct.c_void_p() for _ in range(4)]
+        library.check(lib.cublasLtMatmulDescCreate(_ct.byref(self.desc), 68, 0), 'descriptor')
+        if sm_count:
+            smc = _ct.c_int(sm_count)
