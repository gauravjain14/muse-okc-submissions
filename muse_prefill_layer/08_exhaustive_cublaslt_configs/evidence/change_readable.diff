+        self.algo = _DAlgo()
+        library.check(lib.cublasLtMatmulAlgoInit(library.handle, 68, 0, 14, 14, otype, otype, int(settings[0]), _ct.byref(self.algo)), 'algo init')
+        for attr in range(1, 9):
