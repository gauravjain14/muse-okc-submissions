+'Explicit cuBLASLt algorithm configs for the dense GEMMs, from an exhaustive AlgoCheck-validated search (algo id x tile x\nstages x cluster x split-K x swizzle x custom option) timed as CUDA-graph replays after a cold L2\n(research/claude/lt/lt_prefill.py). Each config is rebuilt from its attributes in the loaded library and checked with\ncublasLtMatmulAlgoCheck; if that fails the measured heuristic plan stays.'
+LT_X_ALGOS = {(16384, 'pooler'): ('tn', (66, 29, 1, 0, 0, 1, 35, 0, 3), True), (16384, 'qkv_gate'): ('tn', (66, 409, 1, 0, 0, 1, 35, 0, 3), True), (16384, 'router512'): ('tn', (66, 408, 1, 0, 0, 3, 35, 0, 5), True), (3012, 'fused'): ('nn', (66, 408, 1, 0, 0, 3, 35, 0, 5), True), (3012, 'o'): ('tn', (66, 408, 1, 0, 0, 3, 35, 0, 5), True), (3012, 'qkv_gate'): ('tn', (66, 496, 1, 0, 0, 5, 35, 0, 2), True), (3012, 'qkv_smt'): ('tn', (66, 408, 1, 0, 0, 1, 35, 0, 6), True), (3012, 'unpooler'): ('tn', (66, 408, 1, 0, 0, 1, 35, 0, 3), True), (753, 'fused'): ('tn', (66, 185, 1, 0, 0, 4, 35, 0, 2), True), (753, 'unpooler'): ('nn', (66, 31, 1, 0, 0, 4, 35, 0, 5), True)}
