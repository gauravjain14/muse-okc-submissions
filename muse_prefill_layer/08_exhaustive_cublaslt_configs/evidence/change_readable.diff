+class DenseLtX:
+    """out[m, n] = x[m, k] @ W^T (W [n, k] BF16), FP32 accumulation, BF16 or FP32 output, one explicit algorithm."""
+
+    def __init__(self, library, m, n, k, workspace, settings, out32=False, sm_count=0, wt=None, ws0=False, src_ptr=0):
+        lib = library.lib
+        v, i_, s_ = (_ct.c_void_p, _ct.c_int, _ct.c_size_t)
+        lib.cublasLtMatmulAlgoInit.argtypes = [v, i_, i_, i_, i_, i_, i_, i_, v]
+        lib.cublasLtMatmulAlgoInit.restype = i_
+        lib.cublasLtMatmulAlgoConfigSetAttribute.argtypes = [v, i_, v, s_]
+        lib.cublasLtMatmulAlgoConfigSetAttribute.restype = i_
