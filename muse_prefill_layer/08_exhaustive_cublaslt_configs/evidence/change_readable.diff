+# Variable-size boundary items for the last-completing m-tiles (BN_TAILR rows each, the last BN_TAILK m-tiles), as
+# a text patch of the incumbent _UB_BODY / _D6_BODY: the rows' math is untouched (outputs bit-identical).
+_TP_FETCH_OLD = '''template <int BM>
+DEVI int ub_fetch(const UParams& p) {
+  constexpr int IPM = BM / UB_R;
+  for (;;) {'''
+_TP_FETCH_NEW = '''#ifndef BN_TAILK
+#define BN_TAILK 1
+#endif
+// BN_TAILR: the last BN_TAILK m-tiles to complete come as finer items of BN_TAILR rows (the boundary left after the
+// last GEMM tile spreads over more CTAs). An item is UB_BND | row0 | rows << 16.
+template <int BM>
+DEVI int bn_ipm(const UParams& p, int slot) {
+#ifdef BN_TAILR
+  return slot >= p.nta - BN_TAILK ? BM / BN_TAILR : BM / UB_R;
+#else
+  (void)p; (void)slot;
+  return BM / UB_R;
+#endif
+}
+template <int BM>
+DEVI int ub_fetch(const UParams& p) {
+  constexpr int IPM = BM / UB_R;
+#ifdef BN_TAILR
+  constexpr int IPM2 = BM / BN_TAILR;
+  const int ke = p.nta > BN_TAILK ? p.nta - BN_TAILK : 0, nb = ke * IPM, ntot = nb + (p.nta - ke) * IPM2;
+#else
+  const int ntot = p.nta * IPM;
+#endif
+  for (;;) {'''
+_TP_CLAIM_OLD = '''        int ta1;
+        while ((ta1 = ld_acquire(p.rq + t / IPM)) == 0) { }
+        const int row0 = (ta1 - 1) * BM + (t % IPM) * UB_R;
+        if (row0 < p.M) return UB_BND | row0;'''
+_TP_CLAIM_NEW = '''#ifdef BN_TAILR
+        const bool late = t >= nb;
+        const int slot = late ? ke + (t - nb) / IPM2 : t / IPM, sub = late ? (t - nb) % IPM2 : t % IPM;
+        const int rr = late ? BN_TAILR : UB_R;
+#else
+        const int slot = t / IPM, sub = t % IPM, rr = UB_R;
+#endif
+        int ta1;
+        while ((ta1 = ld_acquire(p.rq + slot)) == 0) { }
+        const int row0 = (ta1 - 1) * BM + sub * rr;
+        if (row0 < p.M) return UB_BND | row0 | (rr << 16);'''
+_TP_REPS = [
+    (_TP_FETCH_OLD, _TP_FETCH_NEW, 1),
+    (_TP_CLAIM_OLD, _TP_CLAIM_NEW, 1),
+    ('''    if (ld_relaxed(p.ctr + 1) >= p.nta * IPM) return -1;''', '''    if (ld_relaxed(p.ctr + 1) >= ntot) return -1;''', 1),
+    ('''          red_release_add(p.ctr + 3, IPM);''', '''          red_release_add(p.ctr + 3, bn_ipm<BM>(p, slot));''', 1),
+    ('''const int row0 = item & (UB_BND - 1), nr = min(UB_R, p.M - row0);''',
+     '''const int row0 = item & 0xffff, nr = min((item >> 16) & 63, p.M - row0);''', 2),
+]
+
