+            library.check(lib.cublasLtMatmulAlgoConfigSetAttribute(_ct.byref(self.algo), attr, _ct.byref(val), _ct.sizeof(val)), 'algo attribute')
+        res = _DHeur()
+        library.check(lib.cublasLtMatmulAlgoCheck(library.handle, self.desc, self.a, self.b, self.c, self.c, _ct.byref(self.algo), _ct.byref(res)), 'algo check')
+        library.check(res.state, 'algo state')
