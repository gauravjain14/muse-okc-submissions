+def _ltx(state, m, n, k, key, w, out32=False, sm_count=0):
+    """LT_X_ALGOS[key] = (layout, settings, ws0): 'tn' uses W [n, k] as given, 'nn' a transposed copy W^T [k, n];
+    ws0 runs the algorithm without a workspace."""
+    spec = LT_X_ALGOS.get(key)
+    if spec is None:
+        return None
+    layout, settings, ws0 = (tuple(spec) + (False,))[:3]
+    try:
+        wt = None
+        if layout == 'nn':
+            cache = state.setdefault('ltx_wt', {})
+            if w.data_ptr() not in cache:
+                cache[w.data_ptr()] = w.t().contiguous()
+            wt = cache[w.data_ptr()]
+        return DenseLtX(state['prefill_lt_library'], m, n, k, state['prefill_lt_workspace'], settings, out32=out32, sm_count=sm_count, wt=wt, ws0=ws0, src_ptr=w.data_ptr())
+    except (RuntimeError, AttributeError, OSError):
