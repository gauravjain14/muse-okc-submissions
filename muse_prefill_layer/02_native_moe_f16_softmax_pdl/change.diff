+#pragma unroll
+  for (int i = 0; i < 8; ++i) q += red[i];
+  const float r = rsqrtf(q * (1.f / 4096.f) + p.eps);
+  u32* out = reinterpret_cast<u32*>(p.p + row * 4096);
+#pragma unroll
+  for (int k = 0; k < 4; ++k) {
