+    def coeff(g):
+        w = g.float() / 0.3
+        beta = torch.sigmoid(w)
+        return torch.sqrt(torch.clamp(torch.sigmoid(-w) * (1.0 + beta), min=1e-3)).contiguous(), beta.contiguous()
