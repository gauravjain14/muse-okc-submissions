-def _b7_v18s_pack_format(w, fmt):
-    if fmt in (2, 3):
-        hi = w.to(torch.bfloat16)
-        lo = (w - hi.float()).to(torch.bfloat16)
-        mats = [_b7_v18s_units(hi), _b7_v18s_units(lo)]
-    else:
-        mats = [_b7_v18s_units(w)]
-    if fmt in (0, 2):
-        data = torch.cat([_b7_v18s_bf16_bytes(v) for v in mats], dim=-1).contiguous()
-        return {"data": data, "t01": 0, "u01": 0, "esc": None, "fmt": fmt}
-    parts, tabs, escs = [], [], []
-    for h, v in enumerate(mats):
-        data, base, esc = _b7_v18s_c12_bytes(v)
-        if not torch.equal(_b7_v18s_c12_unpack(data, base, esc), v):
-            return None
-        parts.append(data)
-        tabs.append(_b7_v18s_table(base))
-        escs.append(esc + (torch.full_like(esc[0], h),))
-    esc = tuple(torch.cat([e[i] for e in escs]) for i in range(6))
-    return {"data": torch.cat(parts, dim=-1).contiguous(), "t01": tabs[0], "u01": tabs[-1] if fmt == 3 else 0,
-            "esc": esc, "fmt": fmt, "n_esc": int(esc[0].numel())}
