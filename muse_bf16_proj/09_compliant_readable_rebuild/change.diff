-            cpp_sources='#include <torch/extension.h>\n' + next(line for line in _b7_CPP_SRC.splitlines() if line.startswith('void sk2(')) + '\n' + next(line for line in _b7_CPP_SRC.splitlines() if 'int64_t M, int64_t N, int64_t K, int64_t cfg' in line),
-            cuda_sources=src, functions=['sk2'],
-            extra_cuda_cflags=['-O3', '-gencode=arch=compute_90,code=sm_90', '-Xptxas=-v'],
-            no_implicit_headers=True, verbose=False)
