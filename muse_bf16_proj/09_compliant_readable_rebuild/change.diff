+def _q8__pad_rows(w, R, NT):
+    """[N, K] -> [N/R * 8 NT, K]: row block rb (R real rows) occupies rows rb * 8 NT .. + R, the rest zero."""
+    n, k = w.shape
+    nrb = n // R
+    wp = torch.zeros(nrb, 8 * NT, k, dtype=w.dtype, device=w.device)
+    wp[:, :R] = w.view(nrb, R, k)
+    return wp.view(nrb * 8 * NT, k)
+
