-def _b7_v18s_to_i16(v):
-    return torch.where(v >= 32768, v - 65536, v).to(torch.int16)
-
-
-def _b7_v18s_to_i32(v):
-    return torch.where(v >= 2**31, v - 2**32, v).to(torch.int32)
-
