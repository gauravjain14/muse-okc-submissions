+def _q8__nstage(cfg, g):
+    sst = (g["xby"] + g["wby"] + 1023) // 1024 * 1024
+    extra = 1024 + 16 * 16 + 16 + g["elb"] + 2 * g["toks"] * g["rp"] * 4 + 64
+    ring = min(cfg[5] * 1024, _q8_SMEM_LIMIT - extra)
