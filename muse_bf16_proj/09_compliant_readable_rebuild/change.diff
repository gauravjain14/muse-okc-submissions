-def _b7_v18s_bf16_bytes(v):
-    r, c = v.shape[:2]
-    words = _b7_v18s_to_i16(v.view(r, c, 32, 4, 8).permute(0, 1, 3, 2, 4)).contiguous()
-    return words.view(torch.uint8).view(r, c, 2048)
