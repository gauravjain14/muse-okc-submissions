+_r3_RW_CFGS = {"rw128a": (128, 256, 4), "rw128b": (128, 512, 6), "rw64": (64, 512, 6), "rw128bmc": (128, 512, 6),
+           "rw128cmc": (128, 1024, 6), "rw64mc": (64, 512, 6), "rw256": (256, 256, 4), "rw64n8": (64, 512, 8),
