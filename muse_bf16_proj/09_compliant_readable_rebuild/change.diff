+          a0 = fmaf(bf_lo(xv.y), w0.z, a0); a1 = fmaf(bf_hi(xv.y), w0.w, a1);
+          a0 = fmaf(bf_lo(xv.z), w1.x, a0); a1 = fmaf(bf_hi(xv.z), w1.y, a1);
+          a0 = fmaf(bf_lo(xv.w), w1.z, a0); a1 = fmaf(bf_hi(xv.w), w1.w, a1);
+          acc[t][0] = a0; acc[t][1] = a1;
