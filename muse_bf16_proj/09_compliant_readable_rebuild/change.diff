+            a0 = fmaf(x0, bf_lo(h[q]), a0); a1 = fmaf(x0, bf_lo(l[q]), a1);
+            a0 = fmaf(x1, bf_hi(h[q]), a0); a1 = fmaf(x1, bf_hi(l[q]), a1);
+          }
+          acc[t][0] = a0; acc[t][1] = a1;
+        }
+      } else {
