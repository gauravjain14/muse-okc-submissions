+def _q8__tileunits(w):
+    """W [N, K] -> [N/8, K/64, 32 lanes, 16] in mma.m16n8k16 B-fragment order (sk2_tileunits)."""
+    n, k = w.shape
+    t = w.view(n // 8, 8, k // 64, 4, 2, 4, 2)
+    return t.permute(0, 2, 1, 5, 3, 4, 6).reshape(n // 8, k // 64, 32, 16)
+# SPDX-SnippetEnd
