-def _b7_v18s_exact(w_rows, fmt):
-    if fmt in (2, 3):
-        hi = w_rows.to(torch.bfloat16)
-        return hi.float() + (w_rows - hi.float()).to(torch.bfloat16).float()
-    return w_rows
