-def _b7_v18s_units(w):
-    n, k = w.shape
-    bits = w.contiguous().view(torch.int16).to(torch.int32) & 0xFFFF
-    v = bits.view(n // 16, 2, 8, k // 64, 4, 4, 2, 2).permute(0, 3, 2, 4, 5, 6, 1, 7)
-    return v.reshape(n // 16, k // 64, 32, 32)
-
