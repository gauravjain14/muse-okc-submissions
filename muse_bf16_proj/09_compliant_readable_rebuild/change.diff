+_q8_OWN = set(_q8_CFG)
+if os.environ.get("QKVB_OWN") is not None:   # experiments: e.g. "qkv_gate:16"
+    _q8_OWN = set()
+    for _t in filter(None, os.environ["QKVB_OWN"].split(",")):
+        _l, _m = _t.split(":")
+        _q8_OWN.add((_l, int(_m)))
