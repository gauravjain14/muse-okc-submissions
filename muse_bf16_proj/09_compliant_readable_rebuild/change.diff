-def _b7_v18s_plan(ext, inst_id, packs, streams, w, layer, key, inst, cfg):
-    m_hi = key[2] if key[1] == "m" else 8 * inst[1]
-    rows = _b7_v18s_rows(layer, m_hi, w.shape[0])
-    fmt = inst[0]
-    pkey = (layer, rows, fmt)
-    if pkey not in packs:
-        packs[pkey] = _b7_v18s_pack_format(w[:rows].contiguous(), fmt)
-    if packs[pkey] is None:
-        return None
-    skey = pkey + (inst[2],) + tuple(cfg)
-    if skey not in streams:
-        streams[skey] = _b7_v18s_stream(packs[pkey], inst[2], *cfg)
-    sp = streams[skey]
-    if sp is None:
-        return None
-    vkey = ("verified", inst) + skey
-    if vkey not in streams:
-        w_rows = w[:rows].contiguous()
-        lo = 1 if inst[1] == 1 else 4 * inst[1] + 1
-        fixed_m = inst[7] if len(inst) > 7 else 0
-        ms = [fixed_m] if fixed_m else sorted({lo, (lo + 8 * inst[1]) // 2, 8 * inst[1]})
-        streams[vkey] = _b7_v18s_verify_onehot(ext, inst_id[inst], sp, _b7_v18s_exact(w_rows, fmt), cfg, fixed_m or 8 * inst[1]) and\
-            _b7_v18s_verify_random(ext, inst_id[inst], sp, w_rows, cfg, ms)
-    if not streams[vkey]:
-        return None
-    return dict(sp, inst_id=inst_id[inst], cfg=cfg, rows=rows)
