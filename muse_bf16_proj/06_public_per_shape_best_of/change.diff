+
+    def run(self, x, weight, n, plan):
+        _b7__k_ctx_bind(x)
+        mode, layouts, algo = plan
+        out = torch.empty((x.shape[0], n), device=x.device, dtype=torch.bfloat16)
+        a, b, c = layouts
+        ap = _b7__KP(x.data_ptr() if mode == "rownn" else weight.data_ptr())
+        bp = _b7__KP(weight.data_ptr() if mode == "rownn" else x.data_ptr())
+        self.call("cublasLtMatmul", self.handle, self.desc["nn" if mode == "rownn" else mode], _b7_C.byref(self.alpha), ap, a,
+                  bp, b, _b7_C.byref(self.beta), _b7__KP(out.data_ptr()), c, _b7__KP(out.data_ptr()), c,
+                  _b7_C.byref(algo), _b7__KP(self.workspace.data_ptr()), self.workspace.numel(),
+                  _b7__KP(torch.cuda.current_stream().cuda_stream))
+        return out
+
