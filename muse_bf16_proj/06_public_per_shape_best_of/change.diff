-    cnt = esc.sum(1)
-    mx = int(cnt.max())
-    if mx > emax:
-        return None
-    E = max(4, (mx + 3) // 4 * 4)
-    nch = k // 8
-    lo8 = lo.to(torch.uint8).view(n, k)
-    cc = code.to(torch.int32).view(n, nch, 8)
-    cw = (cc[..., 0:4] | (cc[..., 4:8] << 4)).to(torch.uint8).view(n, k // 2)
