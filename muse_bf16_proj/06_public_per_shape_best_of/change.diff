+  const size_t smem = 1024 + (size_t)STAGES * ST_BYTES + 16 * STAGES + (size_t)pmax * 8 + (size_t)pmax * TOK * 2 + 64;
+  auto kern = wide_kernel<NWG, TOK, STAGES, HLW, OutT>;
+  int dev = 0;
+  cudaGetDevice(&dev);
+  static bool attr_done = false;
