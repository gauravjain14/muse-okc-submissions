-@tr.jit
-def _b7__cx_ri_router_interleaved_dot(
-    X, PACKED, Y, PARTIAL,
-    M: tl.constexpr, N: tl.constexpr, K: tl.constexpr, PACKED_K: tl.constexpr,
-    XS0: tl.constexpr, XS1: tl.constexpr,
-    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,
