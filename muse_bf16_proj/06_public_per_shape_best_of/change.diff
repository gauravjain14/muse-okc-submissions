+# ---------------------------------------------------------------- 12-bit lossless format
+def _mq__compress(w):
+    u = w.contiguous().view(torch.int16).to(torch.int32) & 0xFFFF
+    s, e = u >> 15, (u >> 7) & 0xFF
+    hist = torch.bincount(e.flatten(), minlength=256).cpu()
+    cs = torch.cat([torch.zeros(1, dtype=torch.long), hist.cumsum(0)])
+    best, H = -1, 0
+    for h in range(0, 121):
+        inside = int(cs[2 * h + 16] - cs[2 * h])
+        if inside > best:
+            best, H = inside, h
+    idx = (e >> 1) - H
+    esc = (idx < 0) | (idx > 7)
+    code = torch.where(esc, torch.zeros_like(e), (s << 3) | idx)
+    lo = torch.where(esc, torch.zeros_like(u), u & 0xFF)
+    return code, lo, H, esc, u
+
+
+def _mq__afrag64(t, G, ct):
+    """[N, K] -> [G, CT, j(4), tid(128), 8] in wgmma A-fragment order (64-row groups)."""
+    v = t.contiguous().view(G, 4, 2, 8, ct, 4, 2, 4, 2)          # G, w, rh, lq, c, j, kh, tq, pair
+    v = v.permute(0, 4, 5, 1, 3, 7, 6, 2, 8)                     # G, c, j, w, lq, tq, kh, rh, pair
+    return v.reshape(G, ct, 4, 128, 8)
+
+
+def _mq_prepare_comp(w, S):
+    """Per-CTA contiguous blocks [rb][r][chunk][g][6160] + per (row group, K split) overflow lists."""
+    n, k = w.shape
+    G, ct = n // 64, k // 64
+    dev = w.device
+    code, lo, H, esc, u16 = _mq__compress(w)
+    L = _mq__afrag64(lo, G, ct).to(torch.uint8)
+    Cc = _mq__afrag64(code, G, ct).to(torch.int32)
+    Cb = (Cc[..., 0:4] | (Cc[..., 4:8] << 4)).to(torch.uint8)
+    E = _mq__afrag64(esc.to(torch.int32), G, ct)
+    raw = E.view(G, ct, 4, 4, 32, 8).sum((-1, -2)) > 0             # [G, ct, j, w] unit holds an escape
+    lo_t = _mq__afrag64(u16 & 0xFF, G, ct).to(torch.uint8)             # true low bytes
+    hi_t = _mq__afrag64(u16 >> 8, G, ct).to(torch.uint8)               # high bytes (sign | exponent | mantissa msb)
+    rawthr = raw[..., None].expand(G, ct, 4, 4, 32).reshape(G, ct, 4, 128, 1)
+    L = torch.where(rawthr, lo_t, L)
+    Cb = torch.where(rawthr, hi_t[..., 0:4], Cb)
+    OV = hi_t[..., 4:8].reshape(G, ct, 4, 4, 32, 4).permute(0, 1, 3, 2, 4, 5)
+    Lp = L.view(G, ct, 2, 2, 128, 8).permute(0, 1, 2, 4, 3, 5).reshape(G, ct, 4096)
+    Cp = Cb.permute(0, 1, 3, 2, 4).reshape(G, ct, 2048)
+    rawu = raw.permute(0, 1, 3, 2).reshape(G, ct, 16)              # bit w*4 + j
+    bits = (rawu.to(torch.int64) << torch.arange(16, device=dev, dtype=torch.int64)).sum(-1)
+    cnt = rawu.sum(-1).to(torch.int64)
+    nch = ct // S
+    ovbase = torch.zeros((G, ct), dtype=torch.int64, device=dev)
+    ovstride = 0
+    for r in range(S):
+        a, b = r * nch, (r + 1) * nch
+        cs = torch.cumsum(cnt[:, a:b], -1) - cnt[:, a:b]
+        ovbase[:, a:b] = cs
+        ovstride = max(ovstride, int(cnt[:, a:b].sum(-1).max()) * 128)
+    ovstride = max(128, (ovstride + 127) // 128 * 128)
+    assert ovstride <= 16384, f"overflow {ovstride} too large"
+    hdr = torch.zeros((G, ct, 16), dtype=torch.uint8, device=dev)
+    hdr[..., 0:4] = torch.stack([(bits >> (8 * i)) & 0xFF for i in range(4)], -1).to(torch.uint8)
+    hdr[..., 4:8] = torch.stack([(ovbase >> (8 * i)) & 0xFF for i in range(4)], -1).to(torch.uint8)
+    blk = torch.cat([hdr, Lp, Cp], -1)                             # [G][ct][6160]
+    blk = blk.view(G // 2, 2, S, nch, 6160).permute(0, 2, 3, 1, 4).contiguous().view(-1)
+    ovf = torch.zeros((G * S, ovstride), dtype=torch.uint8, device=dev)
+    ovr = OV.reshape(G, ct, 16, 128)
+    for r in range(S):
+        a, b = r * nch, (r + 1) * nch
+        sel = rawu[:, a:b]
+        gi, ci, bi = sel.nonzero(as_tuple=True)
+        if len(gi):
+            data = ovr[:, a:b][gi, ci, bi]
+            cntg = torch.bincount(gi, minlength=G)
+            start = torch.cumsum(cntg, 0) - cntg
+            pos = torch.arange(len(gi), device=dev) - start[gi]
+            ov2 = ovf.view(G, S, ovstride // 128, 128)
+            ov2[gi, r, pos] = data
+    return {"wc": blk, "ovf": ovf.view(-1), "ovstride": ovstride, "base2": H * 0x01010101,
+            "raw_frac": float(raw.float().mean())}
+
+
+# ---------------------------------------------------------------- NVRTC module (inline)
+class _mq_Module:
+    def __init__(self, src, name="m128.cu"):
+        from cuda.bindings import driver, nvrtc
+        self.driver = driver
+        torch.zeros(1, device="cuda")
+        err, prog = nvrtc.nvrtcCreateProgram(src.encode(), name.encode(), 0, [], [])
+        major, minor = torch.cuda.get_device_capability()
+        opts = [f"--gpu-architecture=sm_{major}{minor}{'a' if major >= 9 else ''}".encode(), b"-std=c++17"]
+        if os.environ.get("CU_LINEINFO"):
+            opts.append(b"-lineinfo")
+        (err,) = nvrtc.nvrtcCompileProgram(prog, len(opts), opts)
+        _, size = nvrtc.nvrtcGetProgramLogSize(prog)
+        log = b" " * size
+        nvrtc.nvrtcGetProgramLog(prog, log)
+        self.log = log.decode(errors="replace").strip("\x00 \n")
+        if err != nvrtc.nvrtcResult.NVRTC_SUCCESS:
+            raise RuntimeError("NVRTC failed:\n" + self.log)
+        err, size = nvrtc.nvrtcGetCUBINSize(prog)
+        cubin = b" " * size
+        nvrtc.nvrtcGetCUBIN(prog, cubin)
+        self.cubin = cubin
+        err, self.module = driver.cuModuleLoadData(cubin)
+        assert int(err) == 0, err
+        self.funcs = {}
+
+    def func(self, name, smem):
+        key = (name, smem)
+        f = self.funcs.get(key)
+        if f is None:
+            d = self.driver
+            err, f = d.cuModuleGetFunction(self.module, name.encode())
+            assert int(err) == 0, (name, err)
+            if smem > 48 * 1024:
+                (err,) = d.cuFuncSetAttribute(f, d.CUfunction_attribute.CU_FUNC_ATTRIBUTE_MAX_DYNAMIC_SHARED_SIZE_BYTES, smem)
+                assert int(err) == 0, (name, smem, err)
+            self.funcs[key] = f
+        return f
+
+    def attrs(self, name, smem=0):
+        d = self.driver
+        f = self.func(name, smem)
+        out = {}
+        for k in ("NUM_REGS", "LOCAL_SIZE_BYTES"):
+            err, v = d.cuFuncGetAttribute(getattr(d.CUfunction_attribute, "CU_FUNC_ATTRIBUTE_" + k), f)
+            out[k] = v
+        return out
+
+    def launch(self, name, grid, block, smem, params):
+        d = self.driver
+        f = self.func(name, smem)
+        raw = ctypes.create_string_buffer(len(params) + 128)
+        addr = (ctypes.addressof(raw) + 63) // 64 * 64
+        ctypes.memmove(addr, params, len(params))
+        argv = (ctypes.c_void_p * 1)(addr)
+        stream = d.CUstream(torch.cuda.current_stream().cuda_stream)
+        (err,) = d.cuLaunchKernel(f, grid, 1, 1, block, 1, 1, smem, stream, ctypes.addressof(argv), 0)
+        assert int(err) == 0, (name, err)
+
+    def max_active_clusters(self, name, smem, block, csize, grid):
+        d = self.driver
+        f = self.func(name, smem)
+        cfg = d.CUlaunchConfig()
+        cfg.gridDimX, cfg.gridDimY, cfg.gridDimZ = grid, 1, 1
+        cfg.blockDimX, cfg.blockDimY, cfg.blockDimZ = block, 1, 1
+        cfg.sharedMemBytes = smem
+        at = d.CUlaunchAttribute()
+        at.id = d.CUlaunchAttributeID.CU_LAUNCH_ATTRIBUTE_CLUSTER_DIMENSION
+        at.value.clusterDim.x, at.value.clusterDim.y, at.value.clusterDim.z = csize, 1, 1
+        cfg.attrs = [at]
+        cfg.numAttrs = 1
+        err, ncl = d.cuOccupancyMaxActiveClusters(f, cfg)
+        return int(ncl) if int(err) == 0 else 0
+
+
+def _mq__tmap2d(ptr, rows, cols, box_rows, box_cols=64):
+    from cuda.bindings import driver as d
+    err, tm = d.cuTensorMapEncodeTiled(
+        d.CUtensorMapDataType.CU_TENSOR_MAP_DATA_TYPE_BFLOAT16, d.cuuint32_t(2), ptr,
+        [d.cuuint64_t(cols), d.cuuint64_t(rows)], [d.cuuint64_t(cols * 2)], [d.cuuint32_t(box_cols), d.cuuint32_t(box_rows)],
+        [d.cuuint32_t(1), d.cuuint32_t(1)], d.CUtensorMapInterleave.CU_TENSOR_MAP_INTERLEAVE_NONE,
+        d.CUtensorMapSwizzle.CU_TENSOR_MAP_SWIZZLE_128B, d.CUtensorMapL2promotion.CU_TENSOR_MAP_L2_PROMOTION_L2_256B,
+        d.CUtensorMapFloatOOBfill.CU_TENSOR_MAP_FLOAT_OOB_FILL_NONE)
+    assert int(err) == 0, err
+    return struct.pack("16Q", *[int(v) for v in tm.opaque])
+
+
+_mq__TM = {}
+
+
+def _mq__xmap(x, m, k):
+    key = (x.data_ptr(), m, k)
+    b = _mq__TM.get(key)
+    if b is None:
+        if len(_mq__TM) > 256:
+            _mq__TM.clear()
+        b = _mq__TM[key] = _mq__tmap2d(x.data_ptr(), m, k, 128)
+    return b
+
+
+def _mq_prepare_m128(weights, layers=("unpooler",)):
+    st = {"ent": {}}
+    src = _mq_DEFINES + _mq_HEAD + _mq__wg_asm(128) + _mq_BODY
+    for layer in layers:
+        w = weights[layer].contiguous()
+        n, k = w.shape
+        S = 2
+        ct = k // 64
+        assert ct % S == 0 and n % 128 == 0
+        cp = _mq_prepare_comp(w, S)
+        nch = ct // S
+        ncta = (n // 128) * S
+        smem = 1024 + _mq_NSX * 16384 + _mq_NSW * ((2 * 6160 + 127) // 128 * 128) + 2 * cp["ovstride"] + (S - 1) * 2 * (16 // S) * 2048
+        assert smem <= _mq_SMEM_MAX, (layer, smem)
+        kn = f"mk_{layer}"
+        src += (f'extern "C" __global__ void __cluster_dims__({S}, 1, 1) __launch_bounds__(384, 1) {kn}(const __grid_constant__ P p) '
+                f'{{ mk_body<{nch}, {n}, {cp["wc"].data_ptr()}ull, {cp["ovf"].data_ptr()}ull, {cp["ovstride"]}, {cp["base2"]}u>(p); }}\n')
+        st["ent"][layer] = {"cp": cp, "n": n, "k": k, "ncta": ncta, "smem": smem, "kn": kn, "S": S}
+    st["mod"] = _mq_Module(src)
+    for e in st["ent"].values():
+        # all clusters must be co-resident (one CTA per SM); otherwise fall back (run returns None)
+        e["clusters"] = st["mod"].max_active_clusters(e["kn"], e["smem"], 384, e["S"], e["ncta"])
+        e["ok"] = e["clusters"] >= e["ncta"] // e["S"]
+    torch.cuda.synchronize()
+    return st
+
+
+def _mq_run_m128(x, config, st):
+    m, layer = config["m"], config["layer"]
+    e = st["ent"].get(layer)
+    if e is None or not e["ok"] or m > 128 or m < 97 or config["n"] != e["n"] or not x.is_contiguous() or x.data_ptr() % 16:
+        return None
+    n, k = e["n"], e["k"]
+    out = torch.empty((m, n), dtype=torch.bfloat16, device=x.device)
+    args = _mq__xmap(x, m, k) + struct.pack("<QQiiii", out.data_ptr(), _mq_TRACE.data_ptr() if _mq_TRACE is not None else 0, m, 0, 0, 0)
+    st["mod"].launch(e["kn"], e["ncta"], 384, e["smem"], args)
+    return out
+
