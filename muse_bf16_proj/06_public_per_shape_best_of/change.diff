+        state["klarge_plans"][key] = state["klarge_lt"].plan(mode, m, n, k, cfg)
+    state["klarge_lt"].workspace = torch.empty(state["klarge_lt"].required_workspace, device="cuda", dtype=torch.uint8)
+    return state
