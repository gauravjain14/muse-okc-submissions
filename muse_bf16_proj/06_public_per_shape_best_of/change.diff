+
+
+def _b7__kplan(tile, custom, cluster):
+    return {"batch": 1, "tile": tile, "stages": 35, "splitk": 1, "red": 0, "swz": 0,
+            "custom": custom, "cluster": cluster}
+
+
+_b7__KLARGE_CONFIGS = {
+    ("qkv_gate", 256): ("tn", _b7__kplan(124, 0, 2)),
+    ("pooler", 256): ("rownn", _b7__kplan(18, 0, 2)),
+    ("pooler", 128): ("nn", _b7__kplan(15, 4, 2)),
