+def _b7__k_ctx_bind(x):
+    if getattr(_b7__KTLS, "device", None) == x.device.index:
+        return
+    global _b7__KCUDA
+    if _b7__KCUDA is None:
+        cu = _b7_C.CDLL("libcuda.so.1")
+        for name, args in (("cuCtxGetCurrent", [_b7_C.POINTER(_b7_C.c_void_p)]),
+                           ("cuDeviceGet", [_b7_C.POINTER(_b7_C.c_int), _b7_C.c_int]),
+                           ("cuDevicePrimaryCtxRetain", [_b7_C.POINTER(_b7_C.c_void_p), _b7_C.c_int]),
+                           ("cuCtxSetCurrent", [_b7_C.c_void_p])):
+            fn = getattr(cu, name)
+            fn.argtypes, fn.restype = args, _b7_C.c_int
+        _b7__KCUDA = cu
+    ctx = _b7_C.c_void_p()
+    _b7__KCUDA.cuCtxGetCurrent(_b7_C.byref(ctx))
+    if not ctx.value:
+        dev, primary = _b7_C.c_int(), _b7_C.c_void_p()
+        index = x.device.index or 0
+        if _b7__KCUDA.cuDeviceGet(_b7_C.byref(dev), index) == 0 and _b7__KCUDA.cuDevicePrimaryCtxRetain(_b7_C.byref(primary), dev) == 0:
+            _b7__KCUDA.cuCtxSetCurrent(primary)
+    _b7__KTLS.device = x.device.index
+
+
+class _b7__KAlgo(_b7_C.Structure):
+    _fields_ = [("data", _b7_C.c_uint64 * 8)]
+
+
+class _b7__KHeuristic(_b7_C.Structure):
+    _fields_ = [("algo", _b7__KAlgo), ("workspaceSize", _b7_C.c_size_t), ("state", _b7_C.c_int),
+                ("wavesCount", _b7_C.c_float), ("reserved", _b7_C.c_int * 4)]
+
+
+class _b7__KLargeLt:
+    def __init__(self):
+        self.lib = _b7_C.CDLL("libcublasLt.so.13")
+        signatures = {
+            "cublasLtCreate": [_b7_C.POINTER(_b7__KP)],
+            "cublasLtMatmulDescCreate": [_b7_C.POINTER(_b7__KP), _b7__KI, _b7__KI],
+            "cublasLtMatmulDescSetAttribute": [_b7__KP, _b7__KI, _b7__KP, _b7__KSZ],
+            "cublasLtMatrixLayoutCreate": [_b7_C.POINTER(_b7__KP), _b7__KI, _b7_C.c_uint64, _b7_C.c_uint64, _b7_C.c_int64],
+            "cublasLtMatrixLayoutSetAttribute": [_b7__KP, _b7__KI, _b7__KP, _b7__KSZ],
+            "cublasLtMatmul": [_b7__KP] * 12 + [_b7_C.POINTER(_b7__KAlgo), _b7__KP, _b7__KSZ, _b7__KP],
+            "cublasLtMatmulAlgoInit": [_b7__KP, _b7__KI, _b7__KI, _b7__KI, _b7__KI, _b7__KI, _b7__KI, _b7__KI, _b7_C.POINTER(_b7__KAlgo)],
+            "cublasLtMatmulAlgoConfigSetAttribute": [_b7_C.POINTER(_b7__KAlgo), _b7__KI, _b7__KP, _b7__KSZ],
+            "cublasLtMatmulAlgoCheck": [_b7__KP, _b7__KP, _b7__KP, _b7__KP, _b7__KP, _b7__KP, _b7_C.POINTER(_b7__KAlgo), _b7_C.POINTER(_b7__KHeuristic)],
+        }
+        for name, argtypes in signatures.items():
+            fn = getattr(self.lib, name)
+            fn.argtypes, fn.restype = argtypes, _b7__KI
+        self.handle = _b7__KP()
+        self.call("cublasLtCreate", _b7_C.byref(self.handle))
+        self.desc = {}
+        for mode, transpose in (("tn", 1), ("nn", 0)):
+            desc = _b7__KP()
+            self.call("cublasLtMatmulDescCreate", _b7_C.byref(desc), 68, 0)
+            op = _b7__KI(transpose)
+            self.call("cublasLtMatmulDescSetAttribute", desc, 3, _b7_C.byref(op), _b7_C.sizeof(op))
+            self.desc["nn" if mode == "rownn" else mode] = desc
+        self.workspace = torch.empty(0, device="cuda", dtype=torch.uint8)
+        self.required_workspace = 0
+        self.alpha, self.beta = _b7_C.c_float(1), _b7_C.c_float(0)
+
+    def __deepcopy__(self, memo):
+        clone = self.__class__.__new__(self.__class__)
+        clone.lib = self.lib
+        clone.handle = self.handle
+        clone.desc = dict(self.desc)
+        clone.workspace = self.workspace.clone()
+        clone.required_workspace = self.required_workspace
+        clone.alpha, clone.beta = self.alpha, self.beta
+        return clone
+
+    def call(self, name, *args):
+        status = getattr(self.lib, name)(*args)
+        if status:
+            raise RuntimeError(f"{name} status {status}")
+
+    def layouts(self, mode, m, n, k, batch):
+        specs = ((k, n // batch, k, k * n // batch), (k, m, k, 0), (n // batch, m, n, n // batch))
+        if mode == "nn":
+            specs = ((n // batch, k, n, n // batch),) + specs[1:]
+        elif mode == "rownn":
+            specs = ((m, k, k, 0), (k, n, n, 0), (m, n, n, 0))
+        layouts = []
+        for rows, cols, ld, stride in specs:
+            desc = _b7__KP()
+            self.call("cublasLtMatrixLayoutCreate", _b7_C.byref(desc), 14, rows, cols, ld)
+            if mode == "rownn":
+                order = _b7__KI(1)
+                self.call("cublasLtMatrixLayoutSetAttribute", desc, 1, _b7_C.byref(order), _b7_C.sizeof(order))
+            count, offset = _b7__KI(batch), _b7_C.c_int64(stride)
+            self.call("cublasLtMatrixLayoutSetAttribute", desc, 5, _b7_C.byref(count), _b7_C.sizeof(count))
+            self.call("cublasLtMatrixLayoutSetAttribute", desc, 6, _b7_C.byref(offset), _b7_C.sizeof(offset))
+            layouts.append(desc)
+        return layouts
+
+    def plan(self, mode, m, n, k, cfg):
+        batch = cfg["batch"]
+        layouts = self.layouts(mode, m, n, k, batch)
+        if "values" in cfg:
+            algo = _b7__KAlgo((_b7_C.c_uint64 * 8)(*cfg["values"]))
+        else:
+            algo = _b7__KAlgo()
+            self.call("cublasLtMatmulAlgoInit", self.handle, 68, 0, 14, 14, 14, 14, 66, _b7_C.byref(algo))
+            attrs = (("tile", 1, _b7_C.c_uint32), ("splitk", 2, _b7_C.c_int32), ("red", 3, _b7_C.c_uint32),
+                     ("swz", 4, _b7_C.c_uint32), ("custom", 5, _b7_C.c_uint32), ("stages", 6, _b7_C.c_uint32),
+                     ("cluster", 8, _b7_C.c_uint16))
+            for name, attr, ctype in attrs:
+                value = ctype(cfg[name])
+                status = self.lib.cublasLtMatmulAlgoConfigSetAttribute(_b7_C.byref(algo), attr, _b7_C.byref(value), _b7_C.sizeof(value))
+                if status:
+                    raise RuntimeError(f"large-proj config {name} status {status}")
