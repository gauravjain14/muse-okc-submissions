+def _z1_run_mz(x, config, st, key=None):
+    m, layer = config["m"], config["layer"]
+    if key is None:
+        key = st["bylayer"].get(layer)
+    e = st["ent"].get(key)
+    if e is None or not e["ok"] or m > 128 or m < 97 or config["n"] != e["n"] or not x.is_contiguous() or x.data_ptr() % 16:
+        return None
+    n, k = e["n"], e["k"]
+    out = torch.empty((m, n), dtype=torch.bfloat16, device=x.device)
+    args = _z1__xmap(x, m, k, st["xbox"]) + struct.pack("<QQiiii", out.data_ptr(), _z1_TRACE.data_ptr() if _z1_TRACE is not None else 0, m, 0, 0, 0)
+    st["mod"].launch(e["kn"], e["ncta"], e["nthr"], e["smem"], args)
+    return out
