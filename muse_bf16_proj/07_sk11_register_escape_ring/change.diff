+def _x3__nesc(cfg, layer, m):
+    g = _x3__geom(cfg, layer, m)
+    if _x3__em(cfg, layer, m) == 2:
+        return 0
+    if cfg[9] & _x3_FLAG_ESC1 and _x3__em(cfg, layer, m) == 0:
+        return g["nstage"]
+    return 4 if g["nstage"] >= 4 else g["nstage"]
