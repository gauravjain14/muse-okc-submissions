+def _z1_prepare_mz(weights, cfgs=None):
+    """cfgs: {key: (layer, S, EPI[, RG])} or {layer: (S, EPI[, RG])}; key is what run_mz's `key` argument selects."""
+    cfgs = _z1_DEFAULT_CFG if cfgs is None else cfgs
+    st = {"ent": {}, "bylayer": {}, "xbox": 64 if "MZ_XHALF" in _z1_DEFINES else 128}
+    src = _z1_DEFINES + _z1_HEAD + _z1__wg_asm(128) + _z1_BODY
+    nsm = torch.cuda.get_device_properties(0).multi_processor_count
+    for key, c in cfgs.items():
+        if isinstance(key, str):
+            layer, c = key, tuple(c)
+        else:
+            layer, c = c[0], tuple(c[1:])
+        S, epi = c[0], c[1]
+        RG = c[2] if len(c) > 2 else 2
+        w = weights[layer].contiguous()
+        n, k = w.shape
+        ct = k // 64
+        rows = 64 * RG
+        assert n % rows == 0 and k % 64 == 0 and ct >= 3 * S
+        assert {1: S == 2, 3: S == 4, 2: S == 1}.get(epi, True) and (RG == 2 or epi == 2)
+        cp = _z1_prepare_comp(w, S, RG)
+        nrb = n // rows
+        ncta = nrb * S
+        nthr = 128 * (RG + 1)
+        smem = (1024 + _z1_NSX * 16384 + _z1_NSW * ((RG * 6160 + 127) // 128 * 128) + RG * cp["ovstride"]
+                + {1: 32768, 3: 16384}.get(epi, 0))
+        assert smem <= _z1_SMEM_MAX, (layer, smem)
+        ws = torch.full((max(1, ncta) * 16 * 256 * 4 if epi in (0, 3) else 4,), 1, dtype=torch.int32, device=w.device)
+        cnt = torch.zeros(max(nrb, ncta, 1), dtype=torch.int32, device=w.device)
+        kn = f"mz_{layer}_{S}_{epi}_{RG}_{len(st['ent'])}"
+        cl = {1: f"__cluster_dims__({S}, 1, 1) ", 3: "__cluster_dims__(2, 1, 1) "}.get(epi, "")
+        src += (f'extern "C" __global__ void {cl}__launch_bounds__({nthr}, 1) {kn}(const __grid_constant__ P p) '
+                f'{{ mk_body<{ct}, {S}, {n}, {cp["wc"].data_ptr()}ull, {cp["ovf"].data_ptr()}ull, {cp["ovstride"]}, '
+                f'{cp["base2"]}u, {epi}, {ws.data_ptr()}ull, {cnt.data_ptr()}ull, {RG}>(p); }}\n')
+        st["ent"][key] = {"cp": cp, "n": n, "k": k, "ncta": ncta, "smem": smem, "kn": kn, "S": S, "epi": epi, "RG": RG,
+                          "nthr": nthr, "ws": ws, "cnt": cnt, "layer": layer}
+        st["bylayer"].setdefault(layer, key)
+    st["mod"] = _z1_Module(src)
+    for e in st["ent"].values():
+        if e["epi"] in (1, 3):
+            csz = 2
+            e["clusters"] = st["mod"].max_active_clusters(e["kn"], e["smem"], e["nthr"], csz, e["ncta"])
+            e["ok"] = e["clusters"] >= e["ncta"] // csz
+        else:
+            # every CTA of a row block must be co-resident (global reduce-scatter): one wave
+            e["ok"] = st["mod"].max_blocks(e["kn"], e["smem"], e["nthr"]) * nsm >= e["ncta"]
+    torch.cuda.synchronize()
+    return st
