+__device__ __forceinline__ void mbar_wait(u32 b, int ph) {
+  asm volatile("{\n .reg .pred p;\n W: mbarrier.try_wait.parity.shared::cta.b64 p, [%0], %1;\n @!p bra W;\n}\n"
+               :: "r"(b), "r"(ph) : "memory");
