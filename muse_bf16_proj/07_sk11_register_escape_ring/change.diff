+# ======================================================================== module Z: Z/g128.py
+"""g128 (agent Z): 12-bit lossless RS-wgmma GEMM for the pooler (W [4096, 8192]) at 97 <= M <= 128. Self-contained.
+
+prepare_g128(weights) -> state;  run_g128(x, config, state) -> out [M, 4096] bf16, or None for any other shape
+(None = let the base, claude/t3/bo1.py, handle it).
+
+Derived from agent M's m128 kernel (claude/t3/M/m128.py; 12-bit format and RS-wgmma consumer loop from agents W/M).
+Pooler config: 128 CTAs = 32 row blocks (128 rows, 2 consumer warpgroups) x 4 K quarters; the 4 quarters of a row
+block are 2 cluster pairs. Split-K reduction (EPI 3 + MZ_E3R): each CTA owns one token quarter; the partials of the
+other pair's two quarters go to global (st.global, issued first) + a per-pair release/acquire counter; the partial of
+the partner's quarter goes over DSMEM (one 16 KB bulk copy); BF16 via stmatrix staging, 16 B stores.
+The kernel-family documentation (all EPI / RG modes, diagnostics) follows.
+"""
+import ctypes
+import os
+import struct
+
+import torch
+
+_z1_SMEM_MAX = 227 * 1024
+_z1_TRACE = None          # optional int64 tensor [ncta * 16]: globaltimer trace (DEFINES "#define MZ_TRACE")
+_z1_DEFINES = "#define MZ_E3R\n"
+_z1_NSX, _z1_NSW = 6, 6       # the consumer loop is unrolled by 6 with constant slots (M's U6): both rings have 6 slots
+
+# layer -> (N, K); default configs: (S, EPI)
+_z1_LAYERS = {"qkv_gate": (2304, 8192), "o": (8192, 1024), "pooler": (4096, 8192), "unpooler": (8192, 4096)}
+_z1_DEFAULT_CFG = {"pooler": (4, 3, 2)}
