+        a.x = __uint_as_float(o.x) + __uint_as_float(d.x) + pa[ii].x + pb[ii].x;
+        a.y = __uint_as_float(o.y) + __uint_as_float(d.y) + pa[ii].y + pb[ii].y;
+        a.z = __uint_as_float(o.z) + __uint_as_float(d.z) + pa[ii].z + pb[ii].z;
