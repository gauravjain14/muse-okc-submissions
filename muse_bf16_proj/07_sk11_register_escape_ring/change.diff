+template <u64 A> __device__ __forceinline__ u64 caddr() { u64 v; asm("mov.u64 %0, %1;" : "=l"(v) : "n"(A)); return v; }
+__device__ __forceinline__ void stg128(u64 a, float x, float y, float z, float w) {
+  asm volatile("st.global.v4.f32 [%0], {%1,%2,%3,%4};" :: "l"(a), "f"(x), "f"(y), "f"(z), "f"(w) : "memory");
+}
+__device__ __forceinline__ float4 ldcg128(u64 a) {
+  float4 v; asm volatile("ld.global.cg.v4.f32 {%0,%1,%2,%3}, [%4];" : "=f"(v.x), "=f"(v.y), "=f"(v.z), "=f"(v.w) : "l"(a) : "memory");
