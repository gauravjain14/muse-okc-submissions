+# ======================================================================== deliverable API (agent V)
+import torch.nn.functional as _v2__F
+
+# layer -> vg cfg (TM, BN, LAY, S, NS, MC, RED, MAP); measured wins vs bo1 at m = 256 (see NOTES.md)
+_v2_G256_CFG = {
+    # 128 tok x 72 col tiles, split-K 2 without clusters (asymmetric: helpers take 64 - 6 k-blocks and publish their
+    # fp32 partial + flag, finishers take 64 + 6 and fetch it into two ring slots), 9 stages
+    "qkv_gate": (128, 72, 0, 2, 9, 0, 4, 6),
+}
+_v2_G256_M = (256, 256)          # token range handled (scored m = 256 only; partial token tiles are slower than cuBLAS)
+
+
+def _v2_prepare_g256(weights, cfgs=None):
+    st = {"ok": False, "cfg": {}}
+    try:
+        if not torch.cuda.is_available() or torch.cuda.get_device_capability()[0] != 9:
+            return st
+        if torch.cuda.get_device_properties(0).multi_processor_count < 128:
+            return st
+        lc = [(l, _v2_norm(c)) for l, c in (cfgs or _v2_G256_CFG).items() if l in weights]
+        if not lc:
+            return st
+        V = _v2_VG(weights, lc)
+        g = torch.Generator(device="cuda").manual_seed(7)
+        for layer, cfg in lc:
+            W = weights[layer]
+            for m in (256,):
+                x = torch.randn(m, W.shape[1], device="cuda", generator=g).to(torch.bfloat16)
+                x[3] = 0
+                x[3, 5] = 8.0                          # one-hot probe row: must reproduce 8 * W[:, 5] exactly
+                out = V.run(x, layer, cfg)
+                ref = _v2__F.linear(x, W)
+                torch.cuda.synchronize()
+                err = ((out.float() - ref.float()).norm() / ref.float().norm()).item()
+                if not err < 5e-3 or not torch.equal(out[3], (8.0 * W[:, 5].float()).to(torch.bfloat16)):
+                    raise RuntimeError(f"g256 selftest {layer} m={m}: rel err {err}")
+            st["cfg"][layer] = cfg
+        st["V"] = V
+        st["n"] = {l: weights[l].shape[0] for l in st["cfg"]}
+        st["ok"] = True
+    except Exception as e:  # noqa: BLE001 - any failure: the base handles every shape
+        import sys
+        print(f"[g256] disabled: {type(e).__name__}: {str(e)[:200]}", file=sys.stderr)
+        st = {"ok": False, "cfg": {}}
+    return st
+
+
+def _v2_run_g256(x, config, st):
+    if not st.get("ok"):
+        return None
+    layer, m = config["layer"], config["m"]
+    cfg = st["cfg"].get(layer)
+    if (cfg is None or not (_v2_G256_M[0] <= m <= _v2_G256_M[1]) or config["n"] != st["n"][layer] or x.dim() != 2
+            or not x.is_contiguous() or x.data_ptr() % 16 or x.dtype != torch.bfloat16):
+        return None
+    return st["V"].run(x, layer, cfg)
+
