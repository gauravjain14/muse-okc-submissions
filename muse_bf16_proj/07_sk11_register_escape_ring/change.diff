+_z1_BODY = r"""
+// CT: 64-k chunks of the full K; S: K splits (chunks [c0, c1) with c0 = r CT / S); NOUT: output row length.
+// WCA / OVA: 12-bit blob [rb][chunk][g][6160] / overflow lists [G][S][OVS] (compiled-in addresses).
+// WSA / CNTA (EPI 0): fp32 partial workspace [rb][r][16 groups][256 threads] float4 / per-row-block counters.
+// Uneven splits: every CTA runs NCH = ceil(CT / S) chunks (a runtime count makes ptxas serialize the HGMMAs); the
+// chunks past its real range are phantoms: x box fully out of bounds (TMA zero fill), W slot not refilled (stale but
+// finite weights of an earlier chunk of this CTA) -> contributes exactly 0.
+template <int CT, int S, int NOUT, u64 WCA, u64 OVA, int OVS, u32 B2, int EPI, u64 WSA, u64 CNTA, int RG>
+__device__ __forceinline__ void mk_body(const P& p) {
+  // RG: consumer warpgroups = 64-row groups per CTA (1 or 2); EPI 0/1/3 assume RG = 2
+  static_assert(RG == 2 || EPI == 2, "RG 1 only without split-K reduction");
+  constexpr int NCT = 128 * RG;                        // consumer threads
+  constexpr int NCH = (CT + S - 1) / S;
+  constexpr int NSX = 6, NSW = 6, TN = 128, NACC = 64, XB = TN * 128;
+#ifdef MZ_XHALF
+  constexpr int XTX = XB / 2;                          // diagnostic: x box of 64 tokens (wrong result, half the x traffic)
+#else
+  constexpr int XTX = XB;
+#endif
+  constexpr int CB = RG * 6160, WBA = (CB + 127) / 128 * 128;
+  extern __shared__ __align__(1024) unsigned char sm[];
+  const u32 bars = smem_u32(sm);
+  const u32 xf = bars, xe = bars + 8 * NSX, wf = bars + 16 * NSX, we = wf + 8 * NSW, obar = we + 8 * NSW, rbar = obar + 8;
+  const u32 xring = bars + 1024;
+  const u32 wring = xring + NSX * XB;
+  const u32 ovs = wring + NSW * WBA;
+  const u32 rbuf = ovs + 2 * OVS;                      // EPI 1: receive buffer for the partner's half of my token part
+  const int tid = threadIdx.x, lane = tid & 31, wg = tid >> 7;
+  const int cta = blockIdx.x;
+  const int r = cta % S, rb = cta / S;
+  const int c0 = (r * CT) / S, nreal = ((r + 1) * CT) / S - c0;
+#ifdef MZ_ROT
+  const int rot = (rb * MZ_ROT) % nreal;               // k-order rotation per row block (spreads the x L2 reads)
+#define KCH(s) (((s) + rot) % nreal)
+#else
+#define KCH(s) (s)
+#endif
+  constexpr int n = NCH;
+  if (tid == 0) {
+    TR(0);
+    for (int s = 0; s < NSX; ++s) { mbar_init(xf + 8 * s, 1); mbar_init(xe + 8 * s, 4 * RG); }
+    for (int s = 0; s < NSW; ++s) { mbar_init(wf + 8 * s, 1); mbar_init(we + 8 * s, 4 * RG); }
+    mbar_init(obar, 1);
+    mbar_init(rbar, 1);
+    if (EPI == 1) mbar_expect_arrive(rbar, 2 * 8 * 128 * 16);
+    if (EPI == 3) mbar_expect_arrive(rbar, 4 * 256 * 16);
+    asm volatile("fence.mbarrier_init.release.cluster;" ::: "memory");
+    // first stages right away: overflow lists, then x stage s / W slot s interleaved
+    const u64 ova = caddr<OVA>();
+    const u64 wsrc0 = caddr<WCA>() + ((u64)rb * CT + c0) * CB;
+    mbar_expect_arrive(obar, RG * OVS);
+#pragma unroll
+    for (int g = 0; g < RG; ++g) bulk_g2s(ovs + g * OVS, (const void*)(ova + ((u64)(RG * rb + g) * S + r) * OVS), OVS, obar);
+#pragma unroll 1
+    for (int s = 0; s < NSX && s < n; ++s) {
+      mbar_expect_arrive(xf + 8 * s, XTX);
+      tma2d(xring + s * XB, &p.tmx, s < nreal ? (c0 + KCH(s)) * 64 : CT * 64, 0, xf + 8 * s);
+      if (s < nreal) {
+        mbar_expect_arrive(wf + 8 * s, CB);
+        bulk_g2s(wring + s * WBA, (const void*)(wsrc0 + (u64)KCH(s) * CB), CB, wf + 8 * s);
+      } else {
+        mbar_arrive(wf + 8 * s);
+      }
+    }
+#ifdef MZ_WPF
+    // W L2 prefetch MZ_WPF chunks ahead of the ring head (HBM latency off the smem ring)
