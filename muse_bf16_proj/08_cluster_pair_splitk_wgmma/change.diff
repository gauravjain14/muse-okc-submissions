+    W_COPY(sbase + XBY, 0, full0);
+    if constexpr (XP == 9) { mbar_expect_only(xbar_d, XBY); x_copy<FL, XS, UPS, XT>(sbase, &p.xmap, xbar_d, xu0 + XU(XST(0))); }
+    else x_copy<FL, XS, UPS, XT>(sbase, &p.xmap, full0, xu0 + XU(XST(0)));
