+  uint4 o;
+  o.x = prmt(L0, hiA, 0x5140); o.y = prmt(L0, hiA, 0x7362);
+  o.z = prmt(L1, hiB, 0x5140); o.w = prmt(L1, hiB, 0x7362);
+  return o;
+}
