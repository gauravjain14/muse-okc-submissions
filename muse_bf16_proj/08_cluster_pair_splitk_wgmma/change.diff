+__device__ __forceinline__ u32 hi12(u32 x, u32 M87) {
+  u32 r; asm("lop3.b32 %0, %1, %2, %3, 0xEA;" : "=r"(r) : "r"(x), "r"(M87), "n"(0x38383838)); return r;
