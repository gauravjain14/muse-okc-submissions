+  }
+  __syncthreads();
+  if constexpr (SK > 1) asm volatile("barrier.cluster.arrive.relaxed.aligned;" ::: "memory");
+
+  const int tsel = HTR ? (cta == 0 ? 0 : cta == ncta / 2 ? 1 : -1) : -1;
