+_q2_BODY = r"""
+#ifndef VG_BACKOFF
+#define VG_BACKOFF 200
+#endif
+#ifdef VG_TMASTORE
+#define VG_TMASTORE_ON 1
+#else
+#define VG_TMASTORE_ON 0
