+  if ((ABL & 16) && tid == 0) { q.tr[(size_t)blockIdx.x * 192] = tstart; q.tr[(size_t)blockIdx.x * 192 + 1] = ck(); q.tr[(size_t)blockIdx.x * 192 + 5] = gstart; }
