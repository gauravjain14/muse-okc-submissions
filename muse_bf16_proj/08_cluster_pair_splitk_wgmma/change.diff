+    }
+    mbar_init(pbar, 1);
+    mbar_init(cbar, NE > 0 ? NE : 1);
+    if constexpr (SK > 1 || XP == 9) { mbar_init(rbar, 1); }
+    asm volatile("fence.mbarrier_init.release.cluster;" ::: "memory");
+    if constexpr (SK > 1) mbar_expect_tx(rbar, (u32)((SK - 1) * p.M * RS * 4));
