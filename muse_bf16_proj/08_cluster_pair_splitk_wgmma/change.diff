+  __shared__ float redt[(ABL & 32) ? TPC : 1][MT][16][KC + 1];
+  __shared__ float escs[2 * MT * TPC * 16 * E];
+#define EIX(slot, tok) escs[((tok) * E + (slot) % E) * (TPC * 16) + (slot) / E]
