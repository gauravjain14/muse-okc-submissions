+          const float2 t0 = rtab[nq4 * 2], t1 = rtab[nq4 * 2 + 1];
+          const float e0 = k0 * t0.x - k1 * t0.y, o0 = k0 * t0.y + k1 * t0.x;
+          const float e1 = k2 * t1.x - k3 * t1.y, o1 = k2 * t1.y + k3 * t1.x;
+          k0 = e0; k1 = o0; k2 = e1; k3 = o1;
+        }
