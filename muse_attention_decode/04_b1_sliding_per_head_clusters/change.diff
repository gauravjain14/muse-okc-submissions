+      M = fmaxf(M, __shfl_xor_sync(0xffffffffu, M, 2));
+      M = fmaxf(M, __shfl_xor_sync(0xffffffffu, M, 4));
+      M = fmaxf(M, __shfl_xor_sync(0xffffffffu, M, 8));
