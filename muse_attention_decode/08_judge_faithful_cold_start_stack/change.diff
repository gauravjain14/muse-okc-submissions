+__device__ __forceinline__ void w7_t(u32 dump, unsigned long long a, bool on, bool pf) {
+  if (pf) asm volatile("{\n .reg .pred q;\n setp.ne.u32 q, %1, 0;\n @q prefetch.global.L2 [%0];\n}\n" :: "l"(a), "r"((unsigned)on) : "memory");
