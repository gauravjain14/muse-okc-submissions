+    const float ms = mnew == NEG_INF ? 0.f : mnew;
+    const float alpha = ex2(mrow[rh] - ms);
+    mrow[rh] = mnew;
+#pragma unroll
+    for (int d = 0; d < 9; ++d) { o[d][rh * 2] *= alpha; o[d][rh * 2 + 1] *= alpha; }
