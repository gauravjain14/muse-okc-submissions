+  {
+    u32 lo_[8], hi_[8];
+#pragma unroll
+    for (int s = 0; s < 8; ++s) {
+      const int t = (s >> 2) * 16 + ((s >> 1) & 1) * 8 + tig * 2 + (s & 1);
+      const int byte = h * 64 + 8 * g;
+      const int ch = byte >> 4;
+      const uint2 x = *(const uint2*)(st + 4096 + t * 128 + ((ch ^ vswz(t)) << 4) + (byte & 15));
