+      __syncthreads();
+      if (tid < L * 32) {
+        const int kvg = hp * 2 + nhh;
+        float k0 = bf2f(kraw.x & 0xffff), k1 = bf2f(kraw.x >> 16), k2 = bf2f(kraw.y & 0xffff), k3 = bf2f(kraw.y >> 16);
