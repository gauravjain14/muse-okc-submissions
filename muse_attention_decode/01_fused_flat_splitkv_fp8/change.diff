+          const int cc = cf + pp;
+          int sl = 0;
+          if (!ALIGNED && pp == 0) sl = ((long long)cc * NU / G) < first ? 1 : 0;
+          const float* w = p.ws + (((long long)hp * G + cc) * 2 + sl) * SLOT;
