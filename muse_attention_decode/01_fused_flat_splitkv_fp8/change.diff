+        ss += __shfl_xor_sync(0xffffffffu, ss, 2);
+        const float rs = rsqrtf(ss * (1.0f / HD) + 1e-5f);
+#pragma unroll
+        for (int e = 0; e < 16; ++e) f[e] *= rs;
+        if (ROPE) {
+#pragma unroll
+          for (int e = 0; e < 8; ++e) {
+            float sn, cs;
+            sincosf(qpos[rh] * ifr[e], &sn, &cs);
+            const float ev = f[2 * e], od = f[2 * e + 1];
+            f[2 * e] = ev * cs - od * sn;
+            f[2 * e + 1] = ev * sn + od * cs;
