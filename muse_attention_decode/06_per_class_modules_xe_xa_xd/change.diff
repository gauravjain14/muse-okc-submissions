+  if constexpr (VAR == 3) {
+#pragma unroll
+    for (int i = 0; i < 36; ++i) t[i] = 0.f;
+    t[0] = __uint_as_float(pa[0][0] ^ pa[0][1] ^ pa[0][2] ^ pa[0][3] ^ pa[1][0] ^ pa[1][1] ^ pa[1][2] ^ pa[1][3]) * 1e-30f;
