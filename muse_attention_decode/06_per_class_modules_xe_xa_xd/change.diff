+// ---- 128-token step: two 64-token stages (st0, st1) per call, one softmax max / alpha / fold per 128 tokens and one
+// PV chain of 4 k-steps (128 tokens: DeepGEMM's promotion interval) into a fresh t. V^T buffer: 4 blocks of WG_VTB.
+// QV 0: f32 QK, stage 1's QK issued after stage 0's scores are packed to f16 (48 score registers peak);
+//    1: f32 QK, both stages' QK in flight (64); 2: f16-accumulated QK, both in flight (32).
+// hi0 / hi1: valid tokens of each stage (masking only when need_mask).
+template <int QV>
+__device__ __forceinline__ void xd_tile2(WGS& w, const WGC& c, const u32 (&qa)[2][4], u32 st0, u32 st1, int q, int barid,
+                                         bool need_mask, int hi0, int hi1, float sc) {
