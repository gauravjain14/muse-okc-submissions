+    reg_fence(t);
+  } else {
+  wg_fence();
+  wg_n72<0>(t, pa[0], c.vd);
+  wg_n72<1>(t, pa[1], c.vd + (WG_VTB >> 4));
+  wg_commit();
+  pvf();
+  wg_wait<0>();
+  reg_fence(t);
+  }
+#pragma unroll
+  for (int i = 0; i < 36; ++i) w.o[i] = fmaf(w.o[i], alpha[(i >> 1) & 1], t[i]);
+}
