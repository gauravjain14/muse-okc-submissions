+#pragma unroll
+  for (int nb = 0; nb < 4; ++nb) {
+    pa[nb][0] = prmt(sh[8 * nb + 0], sh[8 * nb + 2], 0x6420);
+    pa[nb][1] = prmt(sh[8 * nb + 1], sh[8 * nb + 3], 0x6420);
+    pa[nb][2] = prmt(sh[8 * nb + 4], sh[8 * nb + 6], 0x6420);
