+#ifdef XD_TRACE
+  if (tid == 0) { unsigned sm_; asm volatile("mov.u32 %0, %%smid;" : "=r"(sm_)); XTRV(15, sm_); XTRV(14, partial_cnt); }
+#endif
+  if (partial_cnt == 0) return;
