+#pragma unroll
+          for (int m = 0; m < 4; ++m) {
+            v[4 * m] = ws.o[8 * m + 2 * rh] * inv; v[4 * m + 1] = ws.o[8 * m + 4 + 2 * rh] * inv;
+            v[4 * m + 2] = ws.o[8 * m + 2 * rh + 1] * inv; v[4 * m + 3] = ws.o[8 * m + 4 + 2 * rh + 1] * inv;
+          }
