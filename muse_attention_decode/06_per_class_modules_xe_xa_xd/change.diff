+// ---------------------------------------------------------------------------------------------------------------------
+// verify (q_len 8), batch 1, full layer, tp8, page size 1: xa_b1f_8. 132 CTAs x 4 warpgroups. CTA c owns past tokens
+// [c n / G, (c + 1) n / G) (the last CTA also the 8 new tokens) as <= 10 tiles of 64 tokens, ALL issued at once (every
+// thread 2 rows x 16 B per tile, tile order) with one mbarrier per tile (512 cp.async arrivals + 128 WG-0 arrivals:
+// the new block's slots are written by WG 0). WG (h = wg & 1, par = wg >> 1) attends KV head h of tiles par, par + 2,
+// ...: W9H tile (QK RS wgmma, V^T by ldmatrix/stmatrix, FP16 softmax straight to E4M3 codes, PV accumulated in place,
+// no PV wait inside the loop). End: parity merge in smem, partial rows at the fixed reference (plain stores), the last
+// 128 arrivals each combine one row over the G partials, RMSNorm x sigmoid(gate).
+// ---------------------------------------------------------------------------------------------------------------------
+#define X8_MAXT 10
+#define X8_VTB 2304
+#define X8_VT (X8_MAXT * 16384)
+#define X8_QS (X8_VT + 4 * 2 * 2 * X8_VTB)
+#define X8_MB (X8_QS + 16384)
+#define X8_SMEM (X8_MB + 8 * X8_MAXT + 64)
+#define XW8_CNT 200000   // (after the q_len-1 kernel's words, before the trace area at 262144)
+#define XW8_DONE 200001
+#define XW8_SLOT 524288   // [G][128 rows][68]: O [64] | M_eff | l
+#define XW8_PAR 200002
+#define XW8_LCNT 200003
+#define XW8_LIST 200016    // [<= 256]
+#define XW8_ACC 2097152    // XA8_RED: [2 parity][2 shards][128 rows][68] floats
+#ifndef XA8_RED
+#define XA8_RED 0          // 1: end chain = fixed-reference red.add accumulation + last-arrival epilogue (else 128 row combiners)
+#endif
+#ifndef XA8_SKIPA
+#define XA8_SKIPA 1       // skip the O rescale when no row max of the warp moved (warp vote)
+#endif
+#ifndef XA8_EARLYW
+#define XA8_EARLYW 0      // 1: the first G - 128 arrivals (not combiners) run the combine dry right away
+#endif
+#ifndef XA8_B16
+#define XA8_B16 1         // QK accumulated in f16 (scores come out packed: no cvt, 16 fewer live registers)
+#endif
+#ifndef XA8_PIPE
+#define XA8_PIPE 0        // 1: 2-deep QK pipeline per WG (needs XA8_B16)
+#endif
+#ifndef XA8_FCP
+#define XA8_FCP 0         // 1: fence.proxy.async after a tile's mbarrier wait (cp.async data -> wgmma)
+#endif
+// One combine row over the G partial slots: nthr threads (tidx 0..nthr-1). real = 0: dry run (no smem / global
+// stores) by the code-prefetch warp at the kernel start, so that the combine's code is in L2 at the end.
+__device__ __noinline__ void xa8_comb(int* ws, const u16* qkv, u16* out, int qstride, int hq, int G, int row, int real,
+                                      int nthr, int tidx, float vsc, float* red) {
+  const int lane = tidx & 31, wrp = tidx >> 5, c4 = tidx & 15, q0 = tidx >> 4;
+  const float* sl0 = (const float*)(ws + XW8_SLOT) + (long long)row * 68;
+  float4 a = make_float4(0.f, 0.f, 0.f, 0.f);
+  float L = 0.f;
+  bool fast = true;
+#pragma unroll
+  for (int rr = 0; rr < 5; ++rr) {
+    const int q = q0 + 32 * rr;
+    if (q < G) {
+      const float* sl = sl0 + (long long)q * 128 * 68;
+      const float4 x = __ldcg((const float4*)(sl + 4 * c4));
+      const float2 ml = __ldcg((const float2*)(sl + 64));
+      fast = fast && (ml.x == XA_REF || ml.y == 0.f);
+      a.x += x.x; a.y += x.y; a.z += x.z; a.w += x.w; L += ml.y;
+    }
+  }
+  a.x += __shfl_xor_sync(0xffffffffu, a.x, 16); a.y += __shfl_xor_sync(0xffffffffu, a.y, 16);
+  a.z += __shfl_xor_sync(0xffffffffu, a.z, 16); a.w += __shfl_xor_sync(0xffffffffu, a.w, 16);
+  L += __shfl_xor_sync(0xffffffffu, L, 16);
+  if (real && lane < 16) *(float4*)(red + (wrp * 16 + lane) * 4) = a;
+  if (real && lane == 0) red[1024 + wrp] = L;
+  u32 allf;
+  asm volatile("{\n.reg .pred p, q;\nsetp.ne.u32 p, %1, 0;\nbar.red.and.pred q, 15, %2, p;\nselp.u32 %0, 1, 0, q;\n}\n"
+               : "=r"(allf) : "r"((u32)(fast || !real)), "r"(nthr) : "memory");
+  if (!allf) {   // rare: classic merge of the row (some partial kept its own max)
+    float Mx = NEG_INF;
+#pragma unroll 1
+    for (int q = 0; q < G; ++q) Mx = fmaxf(Mx, __ldcg(sl0 + (long long)q * 128 * 68 + 64));
+    const float Ms = Mx == NEG_INF ? 0.f : Mx;
+    a = make_float4(0.f, 0.f, 0.f, 0.f); L = 0.f;
+    if (tidx < 16) {
+#pragma unroll 1
+      for (int q = 0; q < G; ++q) {
+        const float* sl = sl0 + (long long)q * 128 * 68;
+        const float2 ml = __ldcg((const float2*)(sl + 64));
+        const float f = xa_ex2(ml.x - Ms);
+        const float4 x = __ldcg((const float4*)(sl + 4 * c4));
+        a.x += x.x * f; a.y += x.y * f; a.z += x.z * f; a.w += x.w * f; L += ml.y * f;
+      }
+    }
+  } else if (tidx < 16) {
+    a = make_float4(0.f, 0.f, 0.f, 0.f); L = 0.f;
+#pragma unroll 4
+    for (int w = 0; w < 16; ++w) {
+      const float4 x = *(const float4*)(red + (w * 16 + tidx) * 4);
+      a.x += x.x; a.y += x.y; a.z += x.z; a.w += x.w; L += red[1024 + w];
+    }
+  }
+  if (tidx < 16) {   // epilogue: row (token j = R >> 3, q head 8 h + (R & 7)), d 4 c4 .. 4 c4 + 3
+    const int hh = row >> 6, R = row & 63, j = R >> 3, qh = 8 * hh + (R & 7);
+    const float inv = __fdividef(vsc, L);
+    const float y0 = a.x * inv, y1 = a.y * inv, y2 = a.z * inv, y3 = a.w * inv;
+    float ss = y0 * y0 + y1 * y1 + y2 * y2 + y3 * y3;
+#pragma unroll
+    for (int o2 = 1; o2 < 16; o2 <<= 1) ss += __shfl_xor_sync(0x0000ffffu, ss, o2);
+    const float rs = rsqrtf(ss * (1.f / 64.f) + 1e-5f);
+    const uint2 gw = *(const uint2*)(qkv + (long long)j * qstride + (hq + 4) * 64 + qh * 64 + 4 * tidx);
+    const float z0 = __fdividef(y0 * rs, 1.f + __expf(-xa_bf(gw.x & 0xffff))), z1 = __fdividef(y1 * rs, 1.f + __expf(-xa_bf(gw.x >> 16)));
+    const float z2 = __fdividef(y2 * rs, 1.f + __expf(-xa_bf(gw.y & 0xffff))), z3 = __fdividef(y3 * rs, 1.f + __expf(-xa_bf(gw.y >> 16)));
+    u32 o0, o1;
+    asm("cvt.rn.bf16x2.f32 %0, %1, %2;" : "=r"(o0) : "f"(z1), "f"(z0));
+    asm("cvt.rn.bf16x2.f32 %0, %1, %2;" : "=r"(o1) : "f"(z3), "f"(z2));
+    if (real) *(uint2*)(out + (long long)j * (hq * 64) + qh * 64 + 4 * tidx) = make_uint2(o0, o1);
+  }
+  asm volatile("bar.sync 15, %0;" :: "r"(nthr) : "memory");
+}
+// ---------------------------------------------------------------------------------------------------------------------
+// xa_b1f_1L (XA_L1): decode-1 full on 4 lanes x 4 warps (WS probe 'a' / run1 gather shape). Lane li owns 64-token tiles
+// li, li + 4, li + 8 of the CTA range (3 stages of 16 KB, all issued at once; warp wl copies tokens 16 wl .. 16 wl + 15
+// of each tile). Per tile: one FP8 wgmma QK per head for the lane (S^T [64 tok x 8 q rows] = K Q^T, both operands in
+// smem: no per-warp K loads / conversions); each warp then runs the softmax and the FP16 mma.sync PV on its own 16
+// tokens (as xa_b1f_1). Q in E4M3 (as k34 / FA3). End chain = xa_b1f_1's.
+// ---------------------------------------------------------------------------------------------------------------------
+template <int ACC> __device__ __forceinline__ void xa_wg_ss8(float (&d)[4], u64 a, u64 b) {
+  if (ACC)
+    asm volatile("wgmma.mma_async.sync.aligned.m64n8k32.f32.e4m3.e4m3 {%0,%1,%2,%3}, %4, %5, 1, 1, 1;\n"
+                 : "+f"(d[0]), "+f"(d[1]), "+f"(d[2]), "+f"(d[3]) : "l"(a), "l"(b));
+  else
+    asm volatile("wgmma.mma_async.sync.aligned.m64n8k32.f32.e4m3.e4m3 {%0,%1,%2,%3}, %4, %5, 0, 1, 1;\n"
+                 : "=f"(d[0]), "=f"(d[1]), "=f"(d[2]), "=f"(d[3]) : "l"(a), "l"(b));
+}
+#ifndef XA_FCP1
+#define XA_FCP1 1         // xa_b1f_1L: fence.proxy.async after each stage's wait (j16 measures 0)
+#endif
+#ifndef XA_L1P
+#define XA_L1P 0          // 1: xa_b1f_1L warp partials go into the warp's own dead stage rows right after its loop (no barrier)
+#endif
+#if XA_L1P
+// warp w's partial: O rows 0..7 in its stage-0 K rows (16 wl .., 2 KB), rows 8..15 in its stage-0 V rows, (M_eff, l)
+// in its stage-1 V rows. The lane's K region is dead once the warp's last QK wgmma retired; V rows are warp-private.
+#define XL_PO(w, r) ((float*)(sbp + ((w) >> 2) * 49152 + ((r) >= 8 ? 8192 : 0) + ((w) & 3) * 2048 + ((r) & 7) * 256))
+#define XL_PML(w) ((float*)(sbp + ((w) >> 2) * 49152 + 16384 + 8192 + ((w) & 3) * 2048))
+#else
+#define XL_PO(w, r) ((float*)(sbp + (w) * 12288) + (r) * XA_MS)
+#define XL_PML(w) ((float*)(sbp + (w) * 12288) + 16 * XA_MS)
+#endif
+extern "C" __global__ void __launch_bounds__(512, 1) xa_b1f_1L(const XP p) {
+  extern __shared__ __align__(128) unsigned char xsmL[];
+  __shared__ int xl_last;
+  const int tid = threadIdx.x, warp = tid >> 5, lane = tid & 31, g = lane >> 2, t = lane & 3;
+  const int li = warp >> 2, wl = warp & 3, tl = tid & 127;
