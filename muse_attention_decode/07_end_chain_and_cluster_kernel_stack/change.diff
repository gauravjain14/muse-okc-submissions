+
+def _xb1_kernel_fn(data):
+    cfg = data["config"]
+    qkv = data["qkv"]
+    dev = qkv.device
+    out = torch.empty((1, 1, 16 * 64), dtype=torch.bfloat16, device=dev)
+    pt = data["page_table"]
+    ws = _xb1_ws(dev)
+    G = _XB1_G
+    width = pt.shape[1]
