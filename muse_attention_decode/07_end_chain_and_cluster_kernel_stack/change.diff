+def _xb1_ws(device):
+    key = str(device)
+    w = _XB1_WS.get(key)
+    if w is None:   # self-resetting counters / accumulator shards / exact-partial slots (+ trace stamps at 262144)
+        w = torch.zeros(1048576, dtype=torch.int32, device=device)   # trace stamps at 524288
+        _XB1_WS[key] = w
+    return w
