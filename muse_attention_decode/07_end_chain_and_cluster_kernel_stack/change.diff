+      float L = 0.f;
+#pragma unroll 4
+      for (int w = 0; w < XB1_NW; ++w) {
+        const float4 x = *(const float4*)(XL_PO(w, r) + 4 * c4);
+        a.x += x.x; a.y += x.y; a.z += x.z; a.w += x.w;
+        L += XL_PML(w)[2 * r + 1];
